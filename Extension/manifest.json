{
  "manifest_version": 3,
  "name": "MICO360 Tasks",
  "version": "1.10.0",
  "description": "Manage daily work on a Kanban board — MICO360 Tasks.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Add a task — MICO360 Tasks",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Add a task"
    },
    "open-side-panel": {
      "description": "Open the side panel"
    }
  },
  "omnibox": { "keyword": "mico" },
  "side_panel": { "default_path": "app/panel.html" },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "contextMenus", "activeTab", "sidePanel"],
  "host_permissions": ["https://task.mico360.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
