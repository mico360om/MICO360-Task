# Dependencies
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.expo/
.expo-export-check/

# Environment / secrets — NEVER commit real secrets; only .env.example is tracked
.env
.env.*
!.env.example
!.env.*.example
# Frontend production build config is PUBLIC (VITE_* vars are baked into the client bundle) — tracked.
!/Web Portal/frontend/.env.production

# Logs
*.log
npm-debug.log*

# Vite dev artifacts
*.timestamp-*.mjs

# OS cruft
.DS_Store
Thumbs.db

# Runtime user uploads
uploads/

# Backup copies a development / QA / test server made (docs/BACKUPS.md): they hold the whole
# database, password hashes included — never commit them. The folder is anchored on purpose:
# src/modules/backups/ is source code.
/Web Portal/backend/backups/
/backups/
*.tar.gz
*.tar.gz.enc
*.tar.gz.partial
*.tar.gz.enc.partial
.work-*

# Generated archives / zips
*.zip

# Built Android APKs (build artifacts)
*.apk
# Signing keystores (KEEP PRIVATE, never commit)
*.keystore
*.jks

# Release packages built by tools/release, one folder per environment. Only the guides and the
# settings template are tracked: never the binaries or the live settings (environment.txt has secrets).
/Installer/*
!/Installer/README.md
!/Installer/*/
/Installer/*/*
!/Installer/*/README.md
!/Installer/*/environment.example.txt
