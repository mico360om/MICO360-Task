{
  "name": "mico360-tasks",
  "version": "1.14.0",
  "private": true,
  "description": "MICO360 Tasks — Kanban task & project management (web app + Chrome extension + Node/TS API + MySQL).",
  "workspaces": [
    "Web Portal/backend",
    "Web Portal/frontend",
    "Extension"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "node server.mjs",
    "release": "node tools/release/release.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose -f \"Web Portal/backend/docker-compose.yml\" up -d mysql",
    "db:down": "docker compose -f \"Web Portal/backend/docker-compose.yml\" down"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "vite": "^7.3.7",
    "postcss-selector-parser": "^7.1.7"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
