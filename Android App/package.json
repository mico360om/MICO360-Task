{
  "name": "@mico360/android",
  "version": "0.1.0",
  "private": true,
  "description": "MICO360 Tasks — native Android app (Expo + React Native + TypeScript). Phase 2.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "maestro test .maestro",
    "bundle:check": "expo export --platform android --output-dir .expo-export-check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
