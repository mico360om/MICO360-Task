{
  "expo": {
    "name": "MICO360 Tasks",
    "slug": "mico360-tasks",
    "version": "1.11.0",
    "orientation": "portrait",
    "scheme": "mico360",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#8B1E1E",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B1E1E"
    },
    "android": {
      "package": "com.mico360.tasks",
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B1E1E"
      },
      "permissions": ["INTERNET", "POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "task.mico360.com", "path": "/reset" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "task.mico360.com", "path": "/dashboard" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/my-tasks" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/board" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/projects" },
            { "scheme": "https", "host": "task.mico360.com", "pathPrefix": "/projects/" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/calendar" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/meetings" },
            { "scheme": "https", "host": "task.mico360.com", "pathPrefix": "/meetings/" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/my-action-items" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/chat" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/activity" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/notifications" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/settings" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/profile" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/about" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/reports" },
            { "scheme": "https", "host": "task.mico360.com", "path": "/admin/users" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": ["expo-secure-store", "expo-notifications", "@sentry/react-native/expo", "./plugins/with-lan-cleartext"]
  }
}
