{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://staging.mico360.example/api/v1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://task.mico360.com/api/v1"
      }
    },
    "production-apk": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://task.mico360.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
