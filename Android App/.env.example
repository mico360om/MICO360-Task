# MICO360 Tasks — Android build environment
# Copy to `.env` for local runs. `eas.json` sets these per build profile in the cloud.

# Build flavor: development | preview | production (default: development).
# Selects the app name, Android package id, and default API endpoint (see src/lib/app-env.ts).
APP_ENV=development

# Optional: override the API base URL for this build. Use this to point a dev build at a
# real backend on your LAN (e.g. http://192.168.1.20:4000/api/v1) instead of the emulator
# default (http://10.0.2.2:4000/api/v1). Leave unset to use the flavor's default endpoint.
# Must be prefixed EXPO_PUBLIC_ to be readable by the config at build time.
# EXPO_PUBLIC_API_URL=
