// MICO360 Tasks — database schema (MySQL 8)
// Modules M1 (T1.1–T1.6). Normalized; many-to-many via explicit join tables
// (task_assignees, task_watchers, project_members, task_tags) — never CSV columns.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// 1.23.5: how a project's completion is counted.
enum CompletionMode {
  COUNT
  WEIGHT
}

enum ColumnCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  // A welcome email's "Set your password" link (7 days, single use; sending again replaces it).
  WELCOME
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  SPAM
  BLOCKED
  FAILED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

model User {
  id                         String     @id @default(cuid())
  email                      String     @unique
  username                   String     @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  avatarUrl                  String?
  status                     UserStatus @default(ACTIVE)
  lastActiveAt               DateTime? // last time the user held a live socket (drives presence "last active" + chat delivered)
  // Last sign-in by password, emailed code or fingerprint (a token refresh doesn't count); null: never.
  lastLoginAt                DateTime?
  // When an administrator last sent this person a welcome email (its link is in login_otps, WELCOME).
  welcomeSentAt              DateTime?
  // Onboarding (next release after 1.23.2): when their first invitation (welcome email) went; when the
  // account became theirs (first sign-in, or a password they set with an emailed link); when they proved
  // the mailbox is theirs (an invitation or reset link used, an emailed code entered, or an administrator
  // by hand). Null emailVerifiedAt: not verified — they enter an emailed code at their next sign-in.
  invitedAt                  DateTime?
  activatedAt                DateTime?
  emailVerifiedAt            DateTime?
  // 1.23.6 Invitation & temporary password security. A temporary password (one an administrator gave them)
  // must be changed at the first sign-in; only a new temporary password sets the flag (nobody else is ever
  // forced). Unused, it stops working at temporaryPasswordExpiresAt. Who set it and when are kept — never
  // the value. invitationCancelledAt: the invitation was cancelled — no way in (link, Forgot password,
  // emailed code) until a new invitation or a temporary password.
  mustChangePassword         Boolean    @default(false)
  temporaryPasswordSetAt     DateTime?
  temporaryPasswordSetById   String?
  temporaryPasswordSetBy     User?      @relation("TemporaryPasswordSetBy", fields: [temporaryPasswordSetById], references: [id], onDelete: SetNull)
  temporaryPasswordsSet      User[]     @relation("TemporaryPasswordSetBy")
  temporaryPasswordExpiresAt DateTime?
  invitationCancelledAt      DateTime?
  departmentId               String?
  // Lockout (M2 / T2.11)
  failedLoginAttempts        Int        @default(0)
  lockedUntil                DateTime?
  // Embedded in access tokens; bumping it revokes every outstanding access token for the user
  // (status / role change, delete, password change).
  tokenVersion               Int        @default(0)
  // Preferences
  timezone                   String     @default("UTC")
  // Calendar: an own time zone (null = the company's) and the week's first day (0 Sun, 1 Mon, 6 Sat).
  preferredTimeZone          String?    @db.VarChar(64)
  weekStart                  Int?
  locale                     String     @default("en")
  dateFormat                 String     @default("YYYY-MM-DD")
  theme                      Theme      @default(SYSTEM)
  defaultProjectId           String?
  // "Show my projects only" (an administrator's own): their lists show only the projects they own,
  // manage or are on the team of. Off by default; means nothing for anyone else (they always list so).
  myProjectsOnly             Boolean    @default(false)
  // Compact / comfortable rows (1.23.0, anyone's own): 'comfortable' (today's look) | 'compact' — the
  // website's lists, tables and boards denser. Phones and touch screens always stay comfortable.
  density                    String     @default("comfortable") @db.VarChar(16)
  // 1.23.8 (anyone's own): the website's side menu folded to its icons on a desktop screen, and how wide
  // the Kanban board's columns are ('narrow' | 'normal' | 'wide'). The density above also takes 'detailed'.
  sidebarCollapsed           Boolean    @default(false)
  boardColumnWidth           String     @default("normal") @db.VarChar(16)
  // Manager View (an administrator's own, owner 10 Nov 2026): while on, they are treated as a non-administrator
  // for settings and configuration (the Admin menu's pages, other people's project settings) and stay an
  // administrator for the work. Means nothing for anyone else. See modules/auth/manager-view.ts.
  managerView                Boolean    @default(false)
  // 1.23.4 Smarter Dashboard: the person's own widget arrangement ({ widgets: [{ id, hidden, size }] });
  // null = they follow their group's default (administrators' or everyone else's, set by an administrator).
  dashboardLayout            Json?
  // Per-user notification preferences, e.g. { "muted": ["TASK_COMMENT"] } (null = all enabled).
  notificationPrefs          Json?
  // Training Center (owner, 11 Nov 2026): who this person reports to (overdue mandatory training escalates to
  // them; empty = the Training managers), the Training manager permission (create, edit, publish, assign and
  // report on training - no other administrator powers) and when they finished or skipped the first-time tour.
  reportsToId                String?    @db.VarChar(191)
  trainingManager            Boolean    @default(false)
  tourDoneAt                 DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  deletedAt                  DateTime?

  department           Department?           @relation(fields: [departmentId], references: [id])
  roles                UserRole[]
  memberships          ProjectMember[]
  managedProjects      Project[]             @relation("ProjectManager")
  createdProjects      Project[]             @relation("ProjectCreator")
  createdTasks         Task[]                @relation("TaskCreator")
  /// Tasks this person finished that are waiting for approval, and tasks they approved last.
  approvalsRequested   Task[]                @relation("TaskApprovalRequester")
  approvalsGiven       Task[]                @relation("TaskApprover")
  /// External contacts this person added to tasks (the contact belongs to its task).
  externalContacts     TaskExternalContact[] @relation("ExternalContactCreator")
  guestsCreated        GuestContact[]        @relation("GuestCreator")
  assignments          TaskAssignee[]
  watching             TaskWatcher[]
  comments             Comment[]
  attachments          Attachment[]
  activities           Activity[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  loginOtps            LoginOtp[]
  deviceTokens         DeviceToken[]
  dailyTaskEmails      DailyTaskEmail[]
  weeklySummaryEmails  WeeklySummaryEmail[]
  settings             UserSetting?
  /// Companies: the ones this person belongs to, and the one whose branding and week their own emails use.
  primaryCompanyId     String?
  primaryCompany       Company?              @relation("UserPrimaryCompany", fields: [primaryCompanyId], references: [id], onDelete: SetNull)
  companies            CompanyMember[]
  /// 1.23 Client accounts (role CLIENT only): their organisation and phone (staff leave them empty).
  organisation         String?               @db.VarChar(160)
  phone                String?               @db.VarChar(40)
  /// A client's projects in the Client portal, each with its ticked modules and actions.
  clientGrants         ClientProjectGrant[]
  /// 1.23.7: a client account's bell in the Client portal, and which kinds of notice they want.
  clientNotices        ClientNotice[]
  clientNoticeSettings ClientNoticeSettings?
  /// 1.23.6: the searches this person saved, and the saved searches they pinned to the side menu.
  savedSearches        SavedSearch[]         @relation("SavedSearchOwner")
  savedSearchPins      SavedSearchPin[]      @relation("SavedSearchPinner")
  /// Sign-in challenges (password → emailed code → session): confirming the email address today.
  signInChallenges     SignInChallenge[]

  @@index([status])
  @@index([departmentId])
  @@index([primaryCompanyId])
  @@index([temporaryPasswordSetById])
  @@index([reportsToId])
  @@map("users")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique // ADMIN | EMPLOYEE
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

// ---------------------------------------------------------------------------
// Companies (1.21): several companies on one site. People and projects belong to companies; a
// non-admin sees a project only inside a company they share with it. Settings left null inherit the
// site's (System Settings / MAIL_FROM / the built-in logo). Every company uses the site's time zone.
// ---------------------------------------------------------------------------

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

model Company {
  id           String        @id @default(cuid())
  name         String        @unique @db.VarChar(120)
  code         String        @unique @db.VarChar(10)
  logoUrl      String?       @db.VarChar(500) // null = the built-in logo
  weekStart    Int? // 0 Sun | 1 Mon | 6 Sat; null = System Settings
  workingHours Json? // { days: number[], start: "HH:MM", end: "HH:MM" }; null = System Settings
  senderName   String?       @db.VarChar(120) // null = MAIL_FROM's display name
  status       CompanyStatus @default(ACTIVE)
  archivedAt   DateTime?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members            CompanyMember[]
  projects           ProjectCompany[]
  mainOf             Project[]           @relation("ProjectMainCompany")
  primaryOf          User[]              @relation("UserPrimaryCompany")
  meetings           Meeting[]
  /// Notification & Scheduling centre: its notification rules, holidays and reminder schedules.
  notificationPolicy NotificationPolicy?
  holidays           CompanyHoliday[]
  reminderSchedules  ReminderSchedule[]
  /// 1.24: the company's reusable guest list (people outside the company named on tasks).
  guests             GuestContact[]

  @@index([status])
  @@map("companies")
}

model CompanyMember {
  companyId String
  userId    String
  addedAt   DateTime @default(now())
  addedById String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model ProjectCompany {
  projectId String
  companyId String
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([projectId, companyId])
  @@index([companyId])
  @@map("project_companies")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id                   String         @id @default(cuid())
  code                 String         @unique
  number               String?        @db.VarChar(40) // the client's / contract project number, free text (optional)
  name                 String
  description          String?        @db.Text
  clientName           String?
  managerId            String?
  ownerId              String? // project owner — new tasks default-assign to them
  status               ProjectStatus  @default(PLANNING)
  priority             Priority       @default(NORMAL)
  color                String         @default("#8B1E1E")
  icon                 String?        @db.VarChar(32) // one of the web app's project icons; null = initials
  imageUrl             String?
  startDate            DateTime?
  targetDate           DateTime?
  notes                String?        @db.Text
  /// Each night, unfinished tasks on past board days move to today's board (when the company-wide switch is on too).
  carryForward         Boolean        @default(true)
  /// A task created in the project without a due date gets today's date (the company's calendar day).
  defaultDueToday      Boolean        @default(false)
  /// "New tasks in this project need approval": a task created in it without saying gets the tick.
  newTasksNeedApproval Boolean        @default(false)
  /// 1.23.5: how its completion is counted — the number of tasks (COUNT, as before) or their weight.
  completionMode       CompletionMode @default(COUNT)
  /// Notification & Scheduling: the project's reminder schedule (null: the company's default) and its own
  /// escalation numbers ({ step1Days, step2Days } in working days; null: the company's).
  reminderScheduleId   String?        @db.VarChar(191)
  escalationDays       Json?
  /// 1.23.5: a task's weight when it has none of its own, by its priority (1–10 points each).
  weightUrgent         Int            @default(4)
  weightHigh           Int            @default(3)
  weightNormal         Int            @default(2)
  weightLow            Int            @default(1)
  /// 1.24: "Every task needs a category" — new saves (and edits of a task's categories) must keep one.
  requireCategory      Boolean        @default(false)
  /// Recycle Bin: the highest task number it has used — erasing its newest task (or a merge's main task)
  /// never frees a number (task numbers are never given twice).
  taskNumberMark       Int            @default(0)
  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  manager        User?                @relation("ProjectManager", fields: [managerId], references: [id])
  createdBy      User                 @relation("ProjectCreator", fields: [createdById], references: [id])
  members        ProjectMember[]
  columns        KanbanColumn[]
  tasks          Task[]
  activities     Activity[]
  taskKeyAliases TaskKeyAlias[]
  clientShares   ClientShare[]
  inspections    Inspection[]
  /// Companies: every project belongs to one or more; the main one (always also a project_companies row)
  /// gives it its branding and week.
  mainCompanyId  String?
  mainCompany    Company?             @relation("ProjectMainCompany", fields: [mainCompanyId], references: [id], onDelete: SetNull)
  companies      ProjectCompany[]
  /// 1.23: the client accounts that may open this project in the Client portal.
  clientGrants   ClientProjectGrant[]
  /// 1.23.7: client accounts' notices about this project (their portal bell).
  clientNotices  ClientNotice[]
  /// 1.23.6: saved searches shared with this project's team.
  savedSearches  SavedSearch[]
  /// Project KPIs: its own KPIs that whoever runs it enters each month ("Safety incidents", "Budget used %").
  customKpis     ProjectKpi[]
  /// 1.24: its own task categories (name + colour), in order.
  categories     ProjectCategory[]

  @@index([status])
  @@index([managerId])
  @@index([mainCompanyId])
  @@map("projects")
}

enum ProjectMemberRole {
  MEMBER
  MANAGER
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectMemberRole @default(MEMBER)
  addedAt   DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model KanbanColumn {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  ColumnCategory @default(TODO)
  position  Int
  color     String         @default("#948985")
  enabled   Boolean        @default(true)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, position])
  @@index([projectId])
  @@map("kanban_columns")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id                    String    @id @default(cuid())
  key                   String    @unique // e.g. MICO-142
  title                 String
  description           String?   @db.Text
  projectId             String
  columnId              String
  position              Int       @default(0)
  priority              Priority  @default(NORMAL)
  startDate             DateTime?
  dueDate               DateTime?
  estimatedHours        Float?
  actualHours           Float?
  progress              Int       @default(0)
  /// 1.23.5: its weight in its project's completion (1–10 points); null = the project's default for its priority.
  weight                Int?
  /// Notification & Scheduling: its own reminder schedule (null: its project's).
  reminderScheduleId    String?   @db.VarChar(191)
  /// A milestone: a key date or deliverable of its project (shown on the project dashboard).
  isMilestone           Boolean   @default(false)
  /// Shown on its project's client page (title, status and due date only). Off unless someone who runs
  /// the project turns it on; moving the task to another project turns it off.
  clientVisible         Boolean   @default(false)
  /// 1.23: the Client portal shows its description too (a tick of its own beside "Show to client").
  clientShowDescription Boolean   @default(false)
  /// 1.23: a client signed it off ("Client accepted · date"); cleared when it leaves Done or is sent back.
  clientAcceptedAt      DateTime?
  clientAcceptedById    String?
  createdById           String
  completedAt           DateTime?
  boardDate             DateTime? // per-date boards: the calendar day this task appears on (noon-UTC anchor)
  carryForwardLog       Json? // append-only carry-forward history [{ from, to, at }]
  recurrenceRule        Json? // RecurrenceRule for a recurring task (null = one-off)
  recurrenceParentId    String? // links a generated instance back to its series template
  recurrenceSourceId    String?   @unique // the task this copy was made from — unique, so a task never gets two next copies
  /// The meeting this task was created from (a Live note made into a task); the task links back to it.
  meetingId             String?
  /// The inspection form this task is carried out with (a scheduled check, or a one-off task that
  /// carries a form). Copies of a repeating task keep it. Cleared if the form row is ever removed.
  inspectionFormId      String?
  /// Where the check is done ("Rig 3"); given to the inspection when it starts.
  inspectionPlace       String?   @db.VarChar(200)
  /// Needs approval: the person who runs the project must approve it before it counts as done.
  needsApproval         Boolean   @default(false)
  /// Set while it waits for approval (someone who can't approve finished it): it is NOT done.
  approvalRequestedAt   DateTime?
  /// Who finished it (asked for approval).
  approvalRequestedById String?
  /// Its last approval (history; cleared when it is re-opened).
  approvedAt            DateTime?
  approvedById          String?
  version               Int       @default(0) // optimistic concurrency (T4.3)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  /// 1.23.1 Merge tasks: the main task this one was merged into. A merged task is a read-only merged
  /// record: hidden like a deleted one (deletedAt is set with it), its number an alias of the main task.
  /// Undo (task_merges) clears all four.
  mergedIntoId          String?
  mergedAt              DateTime?
  mergedById            String?
  /// The merge (task_merges) that merged it.
  mergeId               String?
  /// Recycle Bin: who deleted it (no foreign key, like the other "by" columns of history); null = not
  /// recorded (deleted before the Recycle Bin). Merged tasks get none of these three.
  deletedById           String?
  /// Recycle Bin: when it is erased for good — the company midnight 60 days after the day it was deleted.
  binExpiresAt          DateTime?
  /// Recycle Bin: the delete it went with (a series deleted as a whole restores as a whole).
  deleteBatchId         String?
  /// Duplicate Task: the task this one was copied from ("Duplicated from MSSP-34"); null for any other
  /// task. No relation: the original may be deleted or merged later (then nothing is found). Single-task
  /// details only — never in list payloads.
  duplicatedFromId      String?
  /// Task archive (bulk lane): hidden but kept — read-only, out of boards, lists, My Tasks, calendar,
  /// Timeline, reminders, open counts and the daily email; in search, reports on request and the project's
  /// "Archived tasks" list. Null = not archived. An archived Done task still counts as done in every figure.
  archivedAt            DateTime?
  /// Who archived it (no foreign key, like the other "by" columns of history).
  archivedById          String?

  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column              KanbanColumn          @relation(fields: [columnId], references: [id])
  createdBy           User                  @relation("TaskCreator", fields: [createdById], references: [id])
  approvalRequestedBy User?                 @relation("TaskApprovalRequester", fields: [approvalRequestedById], references: [id], onDelete: SetNull)
  approvedBy          User?                 @relation("TaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  assignees           TaskAssignee[]
  watchers            TaskWatcher[]
  tags                TaskTag[]
  comments            Comment[]
  checklist           ChecklistItem[]
  /// 1.23.3: its checklists (each item is in one).
  checklistLists      ChecklistList[]
  /// People outside the company responsible for this task (kept apart from its assignees). 1.24: each row
  /// is the task's link to a guest of its project's company (guestId), with a copy of the guest's details.
  externalContacts    TaskExternalContact[]
  /// 1.24: its categories (from its project's list).
  categories          TaskCategory[]
  attachments         Attachment[]
  dependencies        TaskDependency[]      @relation("DependentTask")
  dependedOnBy        TaskDependency[]      @relation("BlockingTask")
  activities          Activity[]
  meeting             Meeting?              @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  inspectionForm      InspectionForm?       @relation("TaskInspectionForm", fields: [inspectionFormId], references: [id], onDelete: SetNull)
  keyAliases          TaskKeyAlias[]
  /// Inspections carried out for this task, and the failed item this task follows up (if any).
  inspections         Inspection[]          @relation("InspectionTask")
  inspectionFollowUp  InspectionFollowUp?   @relation("InspectionFollowUpTask")
  /// Its entry in the task search index (derived; rebuilt by `npm run search:rebuild`).
  searchIndex         TaskSearchIndex?
  /// Calendar scheduling: time planned to work on it (work blocks) and people's own reminders about it.
  workBlocks          TaskWorkBlock[]
  reminders           TaskReminder[]

  @@index([projectId])
  /// A project's checks (scheduled inspections): its tasks that carry a form.
  @@index([projectId, inspectionFormId])
  @@index([columnId])
  @@index([dueDate])
  @@index([meetingId])
  @@index([inspectionFormId])
  /// A repeating series' copies (a schedule's figures, the repeat's own count).
  @@index([recurrenceParentId])
  @@index([priority])
  @@index([boardDate])
  /// Calendar scheduling: the tasks a range shows by their start (GET /calendar), and the reminder sweep's
  /// "tasks changed since" (a moved date moves a reminder).
  @@index([startDate])
  @@index([updatedAt])
  /// The tasks waiting for approval (To approve lists, the daily email, Management).
  @@index([approvalRequestedAt])
  @@index([approvalRequestedById])
  @@index([approvedById])
  /// 1.23.1: the tasks merged into a main task.
  @@index([mergedIntoId])
  /// Recycle Bin: the nightly erase, and a delete's batch.
  @@index([binExpiresAt])
  @@index([deleteBatchId])
  /// Duplicate Task: an original's copies.
  @@index([duplicatedFromId])
  /// Task archive: a project's archived tasks, and the live ones (archivedAt NULL).
  @@index([projectId, archivedAt])
  @@fulltext([title, description])
  @@map("tasks")
}

/// 1.23.1 Merge tasks: one merge of tasks into a main task — what it chose and changed, and its undo.
/// The merged tasks are those with this mergeId (task_merge_items remembers every row it moved).
model TaskMerge {
  id                String          @id @default(cuid())
  mainTaskId        String
  /// The main task's number and project before and after (a project chosen from another task gives it a new number).
  mainKeyBefore     String
  mainKeyAfter      String
  mainProjectBefore String
  mainProjectAfter  String
  /// The merged tasks, in the order chosen: [{ id, key }].
  taskIds           Json
  /// What the merge changed on the main task, field by field ({ field: { before, after } }), and the choices made.
  changes           Json
  /// What was combined and what was kept once (the preview's counts), for the history and the audit log.
  summary           Json
  mergedById        String
  mergedAt          DateTime        @default(now())
  undoneAt          DateTime?
  undoneById        String?
  items             TaskMergeItem[]

  @@index([mainTaskId])
  @@map("task_merges")
}

/// 1.23.1: a row a merge moved to the main task (a comment, file, checklist item, history line…), or a
/// link it gave it (a person, a tag), and the task it came from — so Undo moves it back.
model TaskMergeItem {
  id         String    @id @default(cuid())
  mergeId    String
  /// comment, attachment, checklist, activity, inspection, followUp, actionItem, notification, assignee,
  /// watcher, tag, contact, contactFill, dependency, alias, aliasNew.
  kind       String    @db.VarChar(20)
  /// The row's id (a person's or tag's id for a link).
  rowId      String
  fromTaskId String
  /// What Undo needs besides: a position, a project, the fields a contact was filled with.
  data       Json?
  merge      TaskMerge @relation(fields: [mergeId], references: [id], onDelete: Cascade)

  @@index([mergeId])
  @@index([kind, rowId])
  @@map("task_merge_items")
}

/// Recycle Bin: how many tasks of a repeating series were erased for good. The repeat still counts them,
/// as it counts deleted copies ("every day, 10 times" stays at 10 made), and so do a schedule's figures.
model TaskSeriesErased {
  seriesId String @id
  erased   Int    @default(0)

  @@map("task_series_erased")
}

/// Task search: one normalised text per task — its keys (old ones too), title, description, live
/// comments and replies, checklist items, assignees' names, external contacts, tags and file names —
/// folded as text-normalize folds a query (case, Arabic letter forms, diacritics). Binary columns,
/// so `LIKE '%part%'` compares bytes: fast, and exact for normalised text. Derived data: the services
/// refresh a task's row after each change, a sweep heals what any other path changed (`stamp` is a
/// fingerprint of the sources), and `npm run search:rebuild` rebuilds it all.
model TaskSearchIndex {
  taskId    String   @id
  /// A line break, each key on its own line, then the title.
  head      Bytes    @db.Blob
  /// The head, then every other field, one item per line.
  doc       Bytes    @db.MediumBlob
  /// 1.23: the normalised description on its own (a match there ranks above one in a comment).
  lead      Bytes?   @db.MediumBlob
  /// What the sources looked like when indexed (task-search-index stampSql).
  stamp     String   @db.VarChar(512)
  /// SEARCH_INDEX_VERSION it was built with: an older one is rebuilt.
  version   Int
  indexedAt DateTime @db.DateTime(3)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_search_index")
}

/// 1.23 Search everything: one normalised text per searchable item other than a task (tasks keep
/// task_search_index) — projects, meetings, meeting notes, final minutes, task files (name + the text
/// read from them) and inspections. Binary columns, folded as text-normalize folds a query. Derived:
/// refreshed after changes, healed by sweeps (`stamp`), rebuilt by `npm run search:rebuild`.
model SearchIndex {
  /// project, meeting, note, minutes, file or inspection.
  kind      String    @db.VarChar(16)
  recordId  String    @db.VarChar(191)
  /// A project's own id; an inspection's project.
  projectId String?   @db.VarChar(191)
  /// A meeting's own id; a note's or the minutes' meeting.
  meetingId String?   @db.VarChar(191)
  /// A file's task.
  taskId    String?   @db.VarChar(191)
  /// Whose it is: a note's author, a file's uploader, an inspection's inspector.
  personId  String?   @db.VarChar(191)
  /// The minutes' DRAFT or APPROVED; an inspection's IN_PROGRESS or FINISHED.
  status    String?   @db.VarChar(16)
  /// Its date: a note written, a file added, an inspection started, the minutes approved (else drafted), a project created.
  at        DateTime? @db.DateTime(3)
  /// A line break, then its title (and a project's code and number).
  head      Bytes     @db.Blob
  /// Its main text: a description, a note, the minutes' summary, the text of a file.
  lead      Bytes?    @db.MediumBlob
  /// The head, then everything else it is found by, one item per line.
  doc       Bytes     @db.MediumBlob
  /// A meeting: what someone invited from another company may search (title, description, agenda, place).
  limited   Bytes?    @db.MediumBlob
  stamp     String    @db.VarChar(512)
  version   Int
  indexedAt DateTime  @db.DateTime(3)

  @@id([kind, recordId])
  @@index([meetingId])
  @@index([taskId])
  @@index([projectId])
  @@map("search_index")
}

/// 1.23: the text read from a task file (PDF, Word, Excel, PowerPoint, CSV, text, or by AI OCR), as shown
/// (capped), and how reading it went: READ, EMPTY (nothing to read), OCR_WAIT (a scan or a picture waiting
/// for AI OCR), FAILED, SKIPPED (a kind of file that has no text).
model SearchFileText {
  fileId    String     @id
  status    String     @db.VarChar(12)
  /// pdf, office, text or ocr.
  method    String?    @db.VarChar(8)
  text      String?    @db.MediumText
  attempts  Int        @default(0)
  nextTryAt DateTime?
  error     String?    @db.VarChar(300)
  readAt    DateTime   @db.DateTime(3)
  file      Attachment @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([status, nextTryAt])
  @@map("search_file_texts")
}

/// 1.23: the words in the search index (normalised), for the spelling-mistake pass. Only grows; a word no
/// longer anywhere simply finds nothing.
model SearchWord {
  word String @id @db.VarChar(64)

  @@map("search_words")
}

/// 1.23 meaning ("semantic") search, only when an embedding model is set up: one vector per item.
model SearchEmbedding {
  /// task, or a search_index kind.
  kind       String   @db.VarChar(16)
  recordId   String   @db.VarChar(191)
  /// The model (its id in AI Management) that made it: another model's vectors are made again.
  model      String   @db.VarChar(191)
  dims       Int
  /// Float32 values, little-endian.
  vector     Bytes    @db.MediumBlob
  /// A hash of the text it was made from (changed text: made again).
  textHash   String   @db.VarChar(16)
  embeddedAt DateTime @db.DateTime(3)

  @@id([kind, recordId])
  @@index([model])
  @@map("search_embeddings")
}

/// 1.23.6 Saved searches: a person's search — the words as typed, the page's filters and the reader's
/// chips taken off — under a name. It may be shared with one project's team (they use and pin it, never
/// change it). It is read again whenever it runs, for whoever runs it ("me" is them), so its results
/// always follow each person's own access.
model SavedSearch {
  id        String           @id @default(cuid())
  ownerId   String
  name      String           @db.VarChar(80)
  q         String           @db.VarChar(200)
  /// The page's filters: type, projectId, status, person, from, to, done, archived, off (chips taken off), plain.
  filters   Json?
  /// Shared with this project's team; null: its owner's alone.
  projectId String?
  sharedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  owner     User             @relation("SavedSearchOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  pins      SavedSearchPin[]

  @@index([ownerId])
  @@index([projectId])
  @@map("saved_searches")
}

/// 1.23.6: a saved search pinned to someone's side menu (up to 5 each: their own, or one shared with them).
model SavedSearchPin {
  userId        String
  savedSearchId String
  position      Int         @default(0)
  createdAt     DateTime    @default(now())
  user          User        @relation("SavedSearchPinner", fields: [userId], references: [id], onDelete: Cascade)
  savedSearch   SavedSearch @relation(fields: [savedSearchId], references: [id], onDelete: Cascade)

  @@id([userId, savedSearchId])
  @@index([savedSearchId])
  @@map("saved_search_pins")
}

/// A task's old key, kept when it moved to another project (RIG-4 became OPS-17): looking up RIG-4
/// still finds the task, and no other task is ever given that key.
model TaskKeyAlias {
  id        String   @id @default(cuid())
  key       String   @unique
  taskId    String
  /// The project the key belonged to: its numbers stay used there (task keys are numbered per project).
  projectId String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@map("task_key_aliases")
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskWatcher {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

/// Calendar scheduling: time planned to work on a task (a "work on it" block) — one person's time, booked
/// by them (an assignee) or planned for them by the task's creator or whoever runs its project. Never
/// changes the task's dates. Kept (hidden) while the task is binned or archived; removed with it by the
/// nightly erase. `userId` / `plannedById` have no foreign key (like the other "by" columns of history).
model TaskWorkBlock {
  id          String   @id @default(cuid())
  taskId      String
  userId      String   @db.VarChar(191)
  plannedById String   @db.VarChar(191)
  startAt     DateTime
  endAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([taskId])
  @@index([startAt])
  @@map("task_work_blocks")
}

/// Calendar scheduling: a person's own reminder about a task — at a date and time (`at`), or a time before
/// its start or due (`anchor` + `offsetMinutes`). `userId` gets it, `setById` set it (themselves, or the
/// task's creator / whoever runs its project for an assignee). `nextAt`: when it goes next (kept in step
/// with the task's dates by the reminder sweep); `sentFor`: the time it was last sent for (it goes again
/// only when that changes). `mutedAt` / `snoozedUntil`: its person's own, for one someone else set.
model TaskReminder {
  id            String    @id @default(cuid())
  taskId        String
  userId        String    @db.VarChar(191)
  setById       String    @db.VarChar(191)
  at            DateTime?
  anchor        String?   @db.VarChar(8)
  offsetMinutes Int?
  nextAt        DateTime?
  mutedAt       DateTime?
  snoozedUntil  DateTime?
  sentFor       DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, nextAt])
  @@index([taskId])
  @@index([setById])
  @@index([nextAt])
  @@map("task_reminders")
}

/// Calendar scheduling: a person's own Calendar choices (Split | Full, what it shows, the Team blocks).
/// `userId` has no foreign key (a person's own setting, like the minutes send log).
model CalendarPreference {
  userId    String   @id @db.VarChar(191)
  prefs     Json
  updatedAt DateTime @updatedAt

  @@map("calendar_preferences")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String    @default("#3A6EA5")
  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model Comment {
  id            String    @id @default(cuid())
  taskId        String
  userId        String
  body          String    @db.Text
  parentId      String? // set when this comment is a reply to another (threaded replies)
  /// 1.23: written by a client account in the Client portal (shown to the team marked "Client").
  fromClient    Boolean   @default(false)
  /// 1.23: a team reply to a client's comment the client may see ("Visible to client").
  clientVisible Boolean   @default(false)
  editedAt      DateTime?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([parentId])
  @@map("task_comments")
}

/// 1.23.3 Nested checklists: one of a task's checklists ("Electrical"), each with its own title. Every
/// item belongs to one (`listId`); a task's items from before 1.23.3 were put in one titled "Checklist".
/// Deleted ones are kept 30 days (deletedAt; the items deleted with it share `deletedBatchId`) so Undo
/// and the task's history can restore them; a daily sweep removes them for good after that.
model ChecklistList {
  id             String          @id @default(cuid())
  taskId         String
  title          String          @db.VarChar(191)
  position       Int             @default(0)
  /// Who made it (no foreign key, like the other "by" columns of history).
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBatchId String?
  task           Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items          ChecklistItem[]

  @@index([taskId])
  @@index([deletedAt])
  @@map("task_checklist_lists")
}

/// A checklist item. 1.23.3: items nest — `parentId` is the item it sits under (no foreign key: the
/// server keeps the tree, and a deep tree must never hit the database's cascade depth). A parent's
/// `done` is kept in step with its sub-items by the server (done when they all are); a leaf's is set
/// by people. Counts use the leaves only. An item may be for one person (`assigneeId`) by a day
/// (`dueDate`, UTC midnight like a task's). Deleted items are kept 30 days (see ChecklistList).
model ChecklistItem {
  id             String         @id @default(cuid())
  taskId         String
  text           String
  done           Boolean        @default(false)
  position       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  listId         String?
  parentId       String?
  assigneeId     String?
  dueDate        DateTime?
  completedAt    DateTime?
  completedById  String?
  deletedAt      DateTime?
  deletedById    String?
  deletedBatchId String?
  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  list           ChecklistList? @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([listId])
  @@index([parentId])
  /// "Checklist items for me", reminders and the calendar.
  @@index([assigneeId])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("task_checklists")
}

/// A person outside the company who is responsible for a task — a client's engineer, a supplier's
/// site lead — kept apart from the people it is assigned to. Each task keeps its own copy (there is
/// no shared address book: picking an earlier contact copies its details), and a repeating task's
/// next copy gets copies too. Never shown on the project's client page.
model TaskExternalContact {
  id          String   @id @default(cuid())
  taskId      String
  name        String   @db.VarChar(120)
  company     String?  @db.VarChar(120)
  designation String?  @db.VarChar(120)
  email       String?  @db.VarChar(191)
  phone       String?  @db.VarChar(40)
  remarks     String?  @db.VarChar(1000)
  /// Its place in the task's list (0 first).
  position    Int      @default(0)
  /// Who added it (null once that account is removed).
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy   User?    @relation("ExternalContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// 1.24: the guest (of the task's project's company) this row links the task to; null until a row made
  /// before 1.24 (or by an older server) is converted. name…phone are kept equal to the guest's.
  guestId     String?
  guest       GuestContact? @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@index([taskId, position])
  @@index([createdById])
  @@index([guestId])
  @@map("task_external_contacts")
}

/// 1.24 Guests: a company's reusable list of people outside it, named on tasks for the record only. A guest
/// never signs in, has no account, takes no licence and gets no email or notice; clients never see one.
model GuestContact {
  id           String    @id @default(cuid())
  companyId    String
  name         String    @db.VarChar(120)
  company      String?   @db.VarChar(120)
  designation  String?   @db.VarChar(120)
  email        String?   @db.VarChar(191)
  phone        String?   @db.VarChar(40)
  /// Admins' notes, and details the conversion found on other copies of the same person.
  notes        String?   @db.VarChar(2000)
  /// The name as compared (guest-contacts.ts guestTextKey), for the duplicate check.
  nameKey      String    @db.VarChar(191)
  createdById  String?
  /// Retired: hidden from picking, kept on the tasks that have it.
  retiredAt    DateTime?
  /// Merged into another guest by an admin (every task link moved there); hidden.
  mergedIntoId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?                 @relation("GuestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  links     TaskExternalContact[]

  @@index([companyId, nameKey])
  @@index([companyId, retiredAt])
  @@index([createdById])
  @@map("guest_contacts")
}

/// 1.24 Task categories: a project's own labels for its tasks (name + one of 12 colours), in order.
model ProjectCategory {
  id          String    @id @default(cuid())
  projectId   String
  name        String    @db.VarChar(40)
  /// The name as compared (task-categories.ts categoryNameKey): one per project.
  nameKey     String    @db.VarChar(160)
  color       String    @db.VarChar(20)
  position    Int       @default(0)
  /// Retired: hidden from picking, kept on tasks and in filters.
  retiredAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskCategory[]

  @@unique([projectId, nameKey])
  @@index([projectId, position])
  @@map("project_categories")
}

/// 1.24: a task's categories.
model TaskCategory {
  taskId     String
  categoryId String
  addedById  String?
  addedAt    DateTime @default(now())

  task     Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([taskId, categoryId])
  @@index([categoryId])
  @@map("task_categories")
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String // the dependent (blocked) task
  dependsOnTaskId String // the blocking task
  task            Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       Task   @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model Attachment {
  id            String          @id @default(cuid())
  taskId        String
  uploadedById  String
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  url           String
  createdAt     DateTime        @default(now())
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy    User            @relation(fields: [uploadedById], references: [id])
  /// 1.23: the text read from it for search (derived).
  searchText    SearchFileText?
  /// 1.23.7: uploaded by a client account in the Client portal (the team sees it marked "From client").
  fromClient    Boolean         @default(false)
  /// 1.23.7: "Show to client" — every client of the project who may view tasks sees it in the portal
  /// (a client always sees their own uploads; never on the account-less share-link page).
  clientVisible Boolean         @default(false)

  @@index([taskId])
  /// 1.23.29 private file links: a download finds the file's rows by its stored name.
  @@index([storageKey])
  @@map("task_attachments")
}

model Activity {
  id        String   @id @default(cuid())
  taskId    String?
  projectId String?
  userId    String
  action    String
  meta      Json?
  createdAt DateTime @default(now())
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
  @@map("task_activity")
}

// ---------------------------------------------------------------------------
// Notifications, settings, auth artifacts, audit
// ---------------------------------------------------------------------------

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String?   @db.Text
  entityType String?
  entityId   String?
  /// The project the notice is about (tasks, projects, project channels), so lists can follow companies.
  projectId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, projectId])
  /// 1.23.1: the notices about one task (a merge re-points them to the main task, Undo back).
  @@index([entityId])
  @@map("notifications")
}

model UserSetting {
  userId      String @id
  notifyInApp Json?
  notifyEmail Json?
  notifyPush  Json?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// 1.23: a person's own Microsoft account, connected for automatic Teams links (Settings → Microsoft
/// Teams). `userId` has no foreign key (like the minutes send log); the row is removed on Disconnect,
/// deactivation and deletion.
model MicrosoftConnection {
  id              String   @id @default(cuid())
  userId          String   @unique @db.VarChar(191)
  /// The account's tenant (directory) id and Microsoft user id, and how it is named ("Connected as …").
  tenantId        String   @db.VarChar(64)
  microsoftUserId String   @db.VarChar(64)
  email           String?  @db.VarChar(320)
  displayName     String?  @db.VarChar(200)
  /// The refresh token sealed with MS_TOKEN_KEY (AES-256-GCM, version byte, bound to the person); null once refused.
  refreshTokenEnc String?  @db.Text
  /// Why the connection stopped working (connect again), shown in Settings.
  problem         String?  @db.VarChar(300)
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("microsoft_connections")
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  // Rotation family: every token rotated from the same login shares it, so presenting an
  // already-rotated token (reuse → likely theft) revokes the whole family.
  familyId     String?
  /// The token this one was rotated to, sealed with the app's secret box — so a phone whose refresh
  /// reply was lost can present this token again (for 2 minutes) and get that same successor back.
  successorEnc String?   @db.Text
  /// 'biometric' for a phone's fingerprint sign-in key (never refreshes a session; its end moves on
  /// with each use of the app); null for a session's refresh token.
  purpose      String?   @db.VarChar(16)
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Idempotency marker for deadline reminders — one row per (reminder type, task, user, period).
/// A persisted marker (vs. an in-memory guard) means a process restart or a second instance
/// never re-sends the same reminder. `dedupeKey` is the reminder's stable per-period key.
model ReminderLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("reminder_logs")
}

/// Notification & Scheduling centre: a company's notification rules (reminder kinds on, required kinds,
/// escalation / approvals / inactivity numbers, quiet hours, channel defaults) as one JSON document. No
/// row = the defaults (today's behaviour carried over). `holidaysSeededAt`: when the starter public
/// holidays were added (once per company, at start-up or when the company is made).
model NotificationPolicy {
  companyId        String    @id @db.VarChar(191)
  policy           Json
  holidaysSeededAt DateTime?
  updatedById      String?   @db.VarChar(191)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("notification_policies")
}

/// A company's day off: a public holiday (from the starter list, or added) or a company day off, one-off
/// or every year (`recurring`: the same month and day each year from `day`'s year on). `expected`: a
/// date not yet announced (an Islamic holiday), shown with "Confirm".
model CompanyHoliday {
  id          String   @id @default(cuid())
  companyId   String   @db.VarChar(191)
  day         String   @db.VarChar(10)
  name        String   @db.VarChar(120)
  recurring   Boolean  @default(false)
  source      String   @default("ADMIN") @db.VarChar(16)
  expected    Boolean  @default(false)
  createdById String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, day, name])
  @@index([companyId, day])
  @@map("company_holidays")
}

/// A named reminder schedule ("reminder template"): when a task's assignees are reminded, in working days
/// around its due day ({ before, onDue, after, repeatEvery }). Every company starts with Standard (its
/// default) and Critical (`builtIn`); admins add more. Projects and tasks point at one by id (no foreign
/// key: a removed schedule falls back to the company's default).
model ReminderSchedule {
  id        String   @id @default(cuid())
  companyId String   @db.VarChar(191)
  name      String   @db.VarChar(80)
  steps     Json
  builtIn   String?  @db.VarChar(16)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("reminder_schedules")
}

/// A phone push or email held by quiet hours or Pause (the bell already has the notice). At `releaseAt`
/// each person's held pushes go as ONE push, their held emails fold into the morning's daily email (or go
/// as one email). `outcome`: SENT, FOLDED (into the daily email) or DROPPED (past `expiresAt`, e.g. a
/// meeting that started). `userId` has no foreign key (like the minutes send log).
model NotificationHold {
  id             String    @id @default(cuid())
  userId         String    @db.VarChar(191)
  notificationId String?   @db.VarChar(191)
  channel        String    @db.VarChar(8)
  type           String    @db.VarChar(64)
  title          String    @db.VarChar(300)
  body           String?   @db.Text
  entityType     String?   @db.VarChar(40)
  entityId       String?   @db.VarChar(191)
  releaseAt      DateTime
  expiresAt      DateTime?
  doneAt         DateTime?
  outcome        String?   @db.VarChar(16)
  createdAt      DateTime  @default(now())

  @@index([doneAt, releaseAt])
  @@index([userId, doneAt])
  @@map("notification_holds")
}

/// Lease-based lock so a scheduled sweep (reminders, carry-forward) runs on only ONE instance
/// at a time. A holder claims `name` until `lockedUntil`; expired leases are reclaimable, so a
/// crashed holder never deadlocks the job.
model JobLock {
  name        String   @id
  lockedUntil DateTime
  holder      String?
  updatedAt   DateTime @updatedAt

  @@map("job_locks")
}

/// Replay protection for writes that clients may retry (offline queues). A client sends a unique
/// `Idempotency-Key` header on a POST; the first response is stored per user + key, and a retry
/// within the retention window gets that stored response instead of creating a duplicate.
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String
  userId       String
  method       String
  path         String
  statusCode   Int
  responseBody String   @db.LongText
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailLog {
  id                String      @id @default(cuid())
  toAddress         String
  template          String
  subject           String
  status            EmailStatus @default(QUEUED)
  providerMessageId String?
  error             String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([toAddress])
  @@map("email_log")
}

model LoginOtp {
  id         String     @id @default(cuid())
  userId     String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_otps")
}

/// One sign-in challenge: the password was right, and a 6-digit code emailed to `sentTo` finishes the sign-in.
/// Only hashes are kept (the token's SHA-256, the code's keyed HMAC). `kind` VERIFY_EMAIL confirms the address;
/// two-step sign-in will add its own kind. A code lives 10 minutes from its send, a challenge 30 at most.
model SignInChallenge {
  id         String    @id @default(cuid())
  userId     String
  kind       String    @db.VarChar(32)
  tokenHash  String    @unique @db.VarChar(64)
  codeHash   String    @db.VarChar(64)
  sentTo     String    @db.VarChar(191)
  attempts   Int       @default(0)
  sends      Int       @default(1)
  lastSentAt DateTime
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sign_in_challenges")
}

model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ── Chat (M-chat): project channels + 1:1 direct messages ────────────────────
enum ConversationKind {
  PROJECT
  DIRECT
}

model Conversation {
  id           String                    @id @default(cuid())
  kind         ConversationKind
  projectId    String? // set for PROJECT channels; null for DIRECT
  createdAt    DateTime                  @default(now())
  /// Review fix #17 (batch 4b): a DIRECT conversation's pair of people, "<smaller id>:<larger id>" — one
  /// conversation per pair. Null for channels, and for a pair's extra conversations made before it existed.
  directKey    String?                   @unique @db.VarChar(191)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@unique([projectId]) // one channel per project (multiple NULLs allowed for DIRECT)
  @@index([projectId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId  String
  userId          String
  lastReadAt      DateTime?
  addedAt         DateTime     @default(now())
  /// The person's own settings for this conversation (private to them).
  favorite        Boolean      @default(false)
  archivedAt      DateTime?
  mutedAt         DateTime?
  /// When their app last received the conversation's messages ("delivered").
  lastDeliveredAt DateTime?
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  body           String           @db.Text
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  /// The message this one answers (same conversation).
  replyToId      String?
  /// The sender's own id for this message: a retried send with the same id is not stored twice.
  clientId       String?          @db.VarChar(64)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reactions      ChatReaction[]
  attachments    ChatAttachment[]

  @@unique([conversationId, userId, clientId])
  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@map("chat_messages")
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("chat_reactions")
}

model ChatAttachment {
  id         String      @id @default(cuid())
  messageId  String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime    @default(now())
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  /// 1.23.29 private file links: a download finds the file's rows by its stored name.
  @@index([storageKey])
  @@map("chat_attachments")
}

// ─────────────────────────────── Meetings module ───────────────────────────────
// User/Project references are scalar id columns (resolved via the directory, like chat) so the
// User/Project models stay untouched; real relations exist only within the module (with cascades).
enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendeeRole {
  REQUIRED
  OPTIONAL
}

/// An attendee's answer to the invitation (separate from role and from attendance on the day).
enum InvitationResponse {
  PENDING
  ACCEPTED
  TENTATIVE
  DECLINED
}

enum AttendanceStatus {
  INVITED
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MeetingNoteType {
  DISCUSSION
  DECISION
  ACTION
  ISSUE
  QUESTION
  INFORMATION
}

/// How a meeting note's body is written: plain text, or formatted (a safe, fixed HTML form).
enum NoteBodyFormat {
  PLAIN
  RICH
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  PENDING
  COMPLETED
  CANCELLED
}

enum DecisionStatus {
  PROPOSED
  DECIDED
  SUPERSEDED
  CANCELLED
}

enum MinutesStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
}

model Meeting {
  id                    String        @id @default(cuid())
  title                 String
  description           String?       @db.Text
  category              String?
  status                MeetingStatus @default(DRAFT)
  projectId             String?
  organizerId           String
  location              String?
  /// 1.23: up to 2048 characters (a Teams join link is about 250; the API has always taken 2048).
  onlineLink            String?       @db.VarChar(2048)
  /// 1.23: 'TEAMS' when the online link was (or is to be) made by Microsoft Teams; null for a hand-pasted link.
  onlineMeetingProvider String?       @db.VarChar(16)
  /// 1.23: the Teams meeting's id in Microsoft Graph (null: none made yet). Never sent to the apps.
  onlineMeetingId       String?       @db.VarChar(512)
  /// 1.23: whose own Microsoft account made the Teams meeting (only theirs may change or delete it).
  onlineMeetingOwnerId  String?       @db.VarChar(191)
  startAt               DateTime
  endAt                 DateTime?
  timeZone              String?
  recurrenceRule        Json?
  recurrenceParentId    String?
  /// A series meeting's place in its series: the start the rule gave it (kept when it is moved on its own).
  recurrenceStart       DateTime?
  templateId            String?
  transcript            String?       @db.Text
  invitesSentAt         DateTime?
  reminderSentAt        DateTime?
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  attendees     MeetingAttendee[]
  agendaItems   AgendaItem[]
  notes         MeetingNote[]
  actionItems   ActionItem[]
  decisions     Decision[]
  minutes       MeetingMinutes?
  tasks         Task[]
  reminderSends MeetingReminderSend[]
  minutesSends  MeetingMinutesSend[]
  aiJobs        AiJob[]
  /// A meeting without a project belongs to a company (null for project meetings: theirs is the project's).
  companyId     String?
  company       Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// 1.23: the named series it is in ("Monthly site review"), if any — not its repeat (recurrenceParentId).
  seriesId      String?
  namedSeries   MeetingSeries?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  // One meeting per place in a series, so a series is never filled in twice.
  @@unique([recurrenceParentId, recurrenceStart])
  @@index([projectId])
  @@index([organizerId])
  @@index([companyId])
  @@index([seriesId])
  @@index([status])
  @@index([startAt])
  @@index([onlineMeetingId])
  @@map("meetings")
}

/// 1.23: a named series of related meetings ("Monthly site review"): meetings made one by one, repeating
/// meetings (each repeat family is in one), or both. It belongs to a project — or, for meetings without a
/// project, to a company — and only that project's (company's) meetings can be in it. Deleting it unlinks
/// its meetings (never deletes them).
model MeetingSeries {
  id          String    @id @default(cuid())
  name        String    @db.VarChar(200)
  projectId   String?
  /// The company of a series of meetings without a project (null for a project's series).
  companyId   String?
  /// Made automatically for a repeating meeting: removed when it is left empty.
  auto        Boolean   @default(false)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  meetings    Meeting[]

  @@index([projectId])
  @@index([companyId])
  @@map("meeting_series")
}

/// One emailing of a meeting's minutes (1.22): who sent it and when, the draft or the final minutes, the
/// To and Cc lines and each address's result — the meeting's "Sent" log, newest first. `sentById` is the
/// sender's user id (no foreign key: the log outlives an account, as the audit log does).
model MeetingMinutesSend {
  id          String   @id @default(cuid())
  meetingId   String
  sentById    String?
  sentAt      DateTime @default(now())
  final       Boolean  @default(false)
  /// The To line as sent: [{ email, name, userId?, copy }] — copy 'own': their own email (another company).
  toAddresses Json
  /// The Cc line, in the same form.
  ccAddresses Json
  /// Each address's result: [{ email, ok, error? }].
  results     Json
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, sentAt])
  @@map("meeting_minutes_sends")
}

/// One automatic meeting reminder to one person one way (the bell with its phone push, or email):
/// the guard against a second send. Unique per meeting, person, reminder time, the start it was for
/// and way — so retries and several servers send it once, and a moved meeting is reminded again at
/// its new time. `reminderSentAt` on meetings is no longer used (the one-hour email it stamped is gone).
model MeetingReminderSend {
  id            String                    @id @default(cuid())
  meetingId     String
  /// 'user:<id>' or 'guest:<lower-cased email>'.
  recipientKey  String                    @db.VarChar(255)
  userId        String?
  email         String?                   @db.VarChar(255)
  /// The System Settings reminder time: minutes before the start.
  offsetMinutes Int
  /// The meeting's start this reminder was for.
  startAt       DateTime
  channel       MeetingReminderChannel
  status        MeetingReminderSendStatus @default(SENDING)
  sentAt        DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  meeting       Meeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, recipientKey, offsetMinutes, startAt, channel])
  @@index([startAt])
  @@map("meeting_reminder_sends")
}

enum MeetingReminderChannel {
  APP
  EMAIL
}

enum MeetingReminderSendStatus {
  SENDING
  SENT
  SKIPPED
  FAILED
}

model MeetingAttendee {
  id            String             @id @default(cuid())
  meetingId     String
  userId        String?
  externalName  String?
  externalEmail String?
  role          AttendeeRole       @default(REQUIRED)
  attendance    AttendanceStatus   @default(INVITED)
  response      InvitationResponse @default(PENDING)
  respondedAt   DateTime?
  /// When this person's own invitation was delivered (null = not invited yet).
  invitedAt     DateTime?
  department    String?
  createdAt     DateTime           @default(now())
  meeting       Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId])
  @@map("meeting_attendees")
}

model AgendaItem {
  id                 String        @id @default(cuid())
  meetingId          String
  title              String
  ownerId            String?
  expectedMinutes    Int?
  position           Int           @default(0)
  completed          Boolean       @default(false)
  linkedPrevActionId String?
  createdAt          DateTime      @default(now())
  meeting            Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  notes              MeetingNote[]
  actionItems        ActionItem[]

  @@index([meetingId])
  @@map("agenda_items")
}

model MeetingNote {
  id           String                     @id @default(cuid())
  meetingId    String
  agendaItemId String?
  authorId     String
  type         MeetingNoteType            @default(DISCUSSION)
  body         String                     @db.Text
  /// RICH: `body` is formatted text in the fixed HTML form of lib/rich-text.ts.
  bodyFormat   NoteBodyFormat             @default(PLAIN)
  highlighted  Boolean                    @default(false)
  taskId       String?
  actionItemId String?
  decisionId   String?
  createdAt    DateTime                   @default(now())
  editedAt     DateTime?
  /// 1.22.1: who last changed what the note says (the author, the organizer or an administrator).
  editedById   String?
  /// Soft delete: hidden from the meeting, minutes and search, restorable (MTG-07).
  deletedAt    DateTime?
  meeting      Meeting                    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItem   AgendaItem?                @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  attachments  MeetingNoteAttachment[]
  comments     MeetingNoteComment[]
  checklist    MeetingNoteChecklistItem[]

  @@index([meetingId])
  @@index([agendaItemId])
  @@index([type])
  @@map("meeting_notes")
}

model MeetingNoteAttachment {
  id           String      @id @default(cuid())
  noteId       String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  createdAt    DateTime    @default(now())
  note         MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("meeting_note_attachments")
}

model MeetingNoteComment {
  id        String      @id @default(cuid())
  noteId    String
  authorId  String
  body      String      @db.Text
  createdAt DateTime    @default(now())
  note      MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("meeting_note_comments")
}

model MeetingNoteChecklistItem {
  id       String      @id @default(cuid())
  noteId   String
  text     String
  done     Boolean     @default(false)
  position Int         @default(0)
  note     MeetingNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("meeting_note_checklist_items")
}

model ActionItem {
  id           String           @id @default(cuid())
  meetingId    String?
  agendaItemId String?
  sourceNoteId String?
  projectId    String?
  description  String           @db.Text
  assigneeId   String?
  priority     Priority         @default(NORMAL)
  status       ActionItemStatus @default(OPEN)
  dueDate      DateTime?
  progress     Int              @default(0)
  completedAt  DateTime?
  taskId       String?
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  meeting      Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  agendaItem   AgendaItem?      @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@map("action_items")
}

model Decision {
  id           String                @id @default(cuid())
  title        String
  description  String?               @db.Text
  decidedOn    DateTime              @default(now())
  meetingId    String?
  projectId    String?
  ownerId      String?
  status       DecisionStatus        @default(DECIDED)
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  meeting      Meeting?              @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  participants DecisionParticipant[]
  attachments  DecisionAttachment[]

  @@index([meetingId])
  @@index([projectId])
  @@index([status])
  @@map("decisions")
}

model DecisionParticipant {
  decisionId String
  userId     String
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@id([decisionId, userId])
  @@index([userId])
  @@map("decision_participants")
}

model DecisionAttachment {
  id           String   @id @default(cuid())
  decisionId   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  createdAt    DateTime @default(now())
  decision     Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@map("decision_attachments")
}

model MeetingMinutes {
  id                     String        @id @default(cuid())
  meetingId              String        @unique
  content                String        @db.Text
  status                 MinutesStatus @default(DRAFT)
  generatedAt            DateTime      @default(now())
  approvedById           String?
  approvedAt             DateTime?
  sentAt                 DateTime?
  /// Approved minutes shown on the project's client page. Cleared whenever the minutes go back to a draft
  /// or the meeting is re-filed under another project.
  clientVisible          Boolean       @default(false)
  /// The project the minutes were shown to the client of: shown only while the meeting is still that project's.
  clientVisibleProjectId String?
  /// The client copy includes "Risks & open issues" (ticked when the minutes were shown).
  clientShowRisks        Boolean       @default(false)
  meeting                Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_minutes")
}

// ---------------------------------------------------------------------------
// Client view: a read-only page where a client follows one project without an account
// ---------------------------------------------------------------------------

/// A client a project is shared with: one email address per project. The link in their invitation
/// opens the page, and only with a code emailed to this address. Removing the row ends their access
/// (codes and sessions go with it).
model ClientShare {
  id             String             @id @default(cuid())
  projectId      String
  name           String             @db.VarChar(120)
  /// Lower-case, trimmed.
  email          String             @db.VarChar(254)
  /// SHA-256 (hex) of the current link's token; the token itself is only in the email. Resend replaces it.
  linkHash       String             @unique @db.Char(64)
  /// Who shared it (a staff user id; kept when that person is gone).
  createdById    String?
  linkSentAt     DateTime?
  lastViewedAt   DateTime?
  /// When a lockout (too many wrong codes, too many code requests) was last written to the audit log:
  /// at most once an hour per client.
  lockoutNotedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codes          ClientAccessCode[]
  sessions       ClientSession[]

  @@unique([projectId, email])
  @@map("client_shares")
}

/// A one-time code emailed to a shared client (bcrypt hash; 10 minutes, 5 tries). Separate from staff
/// sign-in codes (login_otps), so a client code can never start a staff session.
model ClientAccessCode {
  id         String      @id @default(cuid())
  shareId    String
  codeHash   String      @db.VarChar(100)
  attempts   Int         @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())
  share      ClientShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, createdAt])
  @@map("client_access_codes")
}

/// A device signed in to a client page (30 days): SHA-256 (hex) of the token in its cookie. It opens
/// only that client's page of that one project, never anything else.
model ClientSession {
  id        String      @id @default(cuid())
  shareId   String
  tokenHash String      @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  share     ClientShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId])
  @@map("client_sessions")
}

/// 1.23 Client accounts: a project a client account may open in the Client portal, with the modules and
/// actions an administrator ticked (all off until ticked; at least one module). No row: no access.
/// 1.23.7 A client's role on one project: a ladder of permission sets, or Custom (their own ticks).
enum ClientRole {
  VIEWER
  CONTRIBUTOR
  APPROVER
  CUSTOM
}

model ClientProjectGrant {
  userId      String
  projectId   String
  /// Modules: "Progress, milestones and tasks" (View tasks), "Meetings and minutes".
  progress    Boolean     @default(false)
  meetings    Boolean     @default(false)
  /// Actions: comment on tasks; sign off finished tasks; reply to invites (and their own action items); download PDFs.
  canComment  Boolean     @default(false)
  canSignOff  Boolean     @default(false)
  canRespond  Boolean     @default(false)
  canDownload Boolean     @default(false)
  /// 1.23.7: the role picked in the permission matrix. NULL only on a grant from before 1.23.7 that the
  /// backfill hasn't reached yet (read as CUSTOM); the backfill makes those CUSTOM with notifications on.
  role        ClientRole?
  /// 1.23.7: upload documents to shared tasks (needs View tasks).
  canUpload   Boolean     @default(false)
  /// 1.23.7: receive notifications (the portal bell and emails) about this project.
  canNotify   Boolean     @default(false)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
  @@map("client_project_grants")
}

/// 1.23.7 One notice on a client account's portal bell (also emailed when its kind is). Kinds: REPLY (a team
/// reply to their comment marked "Visible to client"), SIGN_OFF (a shared task is ready for their sign-off),
/// MINUTES (approved minutes were sent to them), DOCUMENT (a file on a shared task was shown to them),
/// INVITATION (a meeting invitation — always sent). Each points at what it is about; the bell shows a
/// notice only while the client may still open that.
model ClientNotice {
  id           String    @id @default(cuid())
  userId       String
  kind         String    @db.VarChar(32)
  projectId    String
  taskId       String?
  meetingId    String?
  attachmentId String?
  title        String    @db.VarChar(191)
  body         String?   @db.VarChar(500)
  readAt       DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId])
  @@map("client_notices")
}

/// 1.23.7 Which kinds of notice a client wants (their portal settings): every kind is on until they switch
/// it off. No row = all on. Meeting invitations aren't here: they always go (part of being invited).
model ClientNoticeSettings {
  userId    String   @id
  reply     Boolean  @default(true)
  signOff   Boolean  @default(true)
  minutes   Boolean  @default(true)
  document  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_notice_settings")
}

model MeetingTemplate {
  id          String   @id @default(cuid())
  name        String
  projectId   String?
  defaults    Json
  createdById String
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("meeting_templates")
}

/// The two morning task emails: one row per person, day and email, so each goes out once. It is the
/// delivery log too: sent, skipped (nothing to report), retrying after a failure, or failed.
enum DailyEmailKind {
  PENDING
  COMPLETED
}

enum DailyEmailStatus {
  SENDING
  SENT
  SKIPPED
  RETRY
  FAILED
}

model DailyTaskEmail {
  id            String           @id @default(cuid())
  userId        String
  /// The person's calendar day the email is for ('YYYY-MM-DD', in their time zone).
  day           String           @db.VarChar(10)
  kind          DailyEmailKind
  status        DailyEmailStatus @default(SENDING)
  attempts      Int              @default(1)
  taskCount     Int              @default(0)
  nextAttemptAt DateTime?
  lastError     String?          @db.Text
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, kind])
  @@index([status, nextAttemptAt])
  @@index([day])
  @@map("daily_task_emails")
}

/// The weekly management summary: one row per person and company week, so it goes out once. It is the
/// delivery log too (the same statuses and retries as the daily task emails).
model WeeklySummaryEmail {
  id            String           @id @default(cuid())
  userId        String
  /// The company week's first day ('YYYY-MM-DD').
  week          String           @db.VarChar(10)
  status        DailyEmailStatus @default(SENDING)
  attempts      Int              @default(1)
  /// Projects in the summary when it went (0 when skipped).
  projectCount  Int              @default(0)
  nextAttemptAt DateTime?
  lastError     String?          @db.Text
  sentAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
  @@index([status, nextAttemptAt])
  @@map("weekly_summary_emails")
}

// ─────────────────────────────── MICO AI ───────────────────────────────
// The owner is a scalar id (like chat and meetings), so the User model stays untouched.

/// A person's private chat with MICO AI: only its owner can open it (admins included).
model MicoAiChat {
  id              String          @id @default(cuid())
  userId          String
  /// '' until the first question names it; the person can rename it.
  title           String          @default("") @db.VarChar(200)
  /// A short running summary of the turns older than the recent window (long chats).
  summary         String?         @db.Text
  /// How many of the oldest messages the summary covers.
  summarizedCount Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  /// When its newest message was added (the chat list's order).
  lastMessageAt   DateTime        @default(now())
  messages        MicoAiMessage[]

  @@index([userId, lastMessageAt])
  @@map("mico_ai_chats")
}

/// A question (role "user") or MICO AI's answer (role "assistant", its tables and sources as JSON).
model MicoAiMessage {
  id        String          @id @default(cuid())
  chatId    String
  role      String          @db.VarChar(16)
  /// The question, or the answer's words: what searching the chats reads.
  text      String          @db.MediumText
  content   Json?
  /// The tool results an answer's tables were copied from (kept for later questions; only they read it).
  results   Json?
  /// PENDING while MICO AI is writing it, then DONE, ERROR or STOPPED.
  status    String          @default("DONE") @db.VarChar(16)
  /// While PENDING: what MICO AI is doing ("Checking tasks in Rig Inspection…").
  step      String?         @db.VarChar(200)
  /// 1.22: a question's id from the page that sent it — sent again (a double click, a retry after a
  /// lost answer), it joins the turn already asked instead of asking twice.
  clientId  String?         @db.VarChar(64)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  chat      MicoAiChat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  proposal  MicoAiProposal?
  aiJobs    AiJob[]

  @@unique([chatId, clientId])
  @@index([chatId, createdAt])
  @@map("mico_ai_messages")
}

/// 1.22 (§10): AI work that keeps running in the background after the page is closed — a Final MOM
/// "Draft with AI" or a MICO AI answer. One active job per thing (`activeKey` is unique while it is
/// queued or running). A server takes a job with a lease it renews while it runs, so several servers
/// never run one twice and a restart picks it up again; a try that fails on a time-out, a 429 or a
/// 5xx waits and goes again (30 s, 2 min, 5 min). The requester's id is a scalar, as for MICO AI chats.
model AiJob {
  id            String         @id @default(cuid())
  /// "final-minutes" or "mico-ai".
  kind          String         @db.VarChar(32)
  /// The thing it is for: the meeting (final-minutes) or the answer's message (mico-ai).
  subjectId     String
  meetingId     String?
  messageId     String?
  /// `${kind}:${subjectId}` while QUEUED or RUNNING, null once it ends: one active job per thing.
  activeKey     String?        @unique @db.VarChar(100)
  requestedById String
  /// QUEUED (waiting for its first or its next try), RUNNING, DONE, FAILED or CANCELLED.
  status        String         @default("QUEUED") @db.VarChar(16)
  /// Tries started so far.
  attempts      Int            @default(0)
  nextTryAt     DateTime       @default(now())
  leaseOwner    String?        @db.VarChar(64)
  leaseUntil    DateTime?
  /// What a try needs: the meeting's facts, the question, the requester's roles and picked company.
  input         Json
  result        Json?
  /// What became of the result: SAVED, OFFERED (kept beside someone's own minutes), USED, DISCARDED, LOST.
  outcome       String?        @db.VarChar(16)
  outcomeAt     DateTime?
  /// The last failed try's { message, code, status }.
  error         Json?
  /// When the requester's page last showed it: they are told by the bell and a push only when it wasn't open.
  watchedAt     DateTime?
  createdAt     DateTime       @default(now())
  /// When the latest try started.
  startedAt     DateTime?
  finishedAt    DateTime?
  updatedAt     DateTime       @updatedAt
  meeting       Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  message       MicoAiMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([status, nextTryAt])
  @@index([kind, subjectId, createdAt])
  @@index([meetingId])
  @@index([messageId])
  @@map("ai_jobs")
}

/// A card of changes MICO AI proposed in an answer (one per answer). Nothing is changed until its
/// owner confirms it; Confirm and Undo move `status` on in one statement, so neither runs twice.
model MicoAiProposal {
  id          String        @id @default(cuid())
  messageId   String        @unique
  userId      String
  /// PROPOSED, then CONFIRMING → DONE (or CANCELLED), then UNDOING → UNDONE.
  status      String        @default("PROPOSED") @db.VarChar(16)
  /// The changes as checked when proposed (names resolved to ids), and as confirmed once confirmed.
  items       Json
  /// A note for the whole card ("Only the first 50 changes are here").
  note        String?       @db.VarChar(300)
  /// The card's "Email the invitations" tick box.
  sendInvites Boolean       @default(true)
  /// Per change, once confirmed: done or refused (with why), and what Undo needs.
  results     Json?
  /// Per change, once undone.
  undo        Json?
  confirmedAt DateTime?
  undoUntil   DateTime?
  undoneAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  message     MicoAiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mico_ai_proposals")
}

// ─────────────────────────────── Templates ───────────────────────────────
// Company-wide starting points: a project's board and standard tasks, or one task. Creator ids are
// scalar (like chat and meetings), so the User model stays untouched. A project made from a template
// keeps no link to it: deleting or changing a template never touches projects made from it.

/// A starting point for new projects: its board columns, the roles its tasks name, and its tasks.
model ProjectTemplate {
  id          String                @id @default(cuid())
  name        String                @db.VarChar(191)
  description String?               @db.Text
  /// Its board, in order: [{ name, category, color }].
  columns     Json
  /// 1.24: its task categories, in order: [{ name, color }] (a project made from it starts with them).
  categories  Json?
  /// Who made it: they can change and delete it (administrators can change any). Kept when they're gone.
  createdById String?
  updatedById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  roles       ProjectTemplateRole[]
  tasks       ProjectTemplateTask[]

  @@index([createdById])
  @@map("project_templates")
}

/// A role a template's tasks name instead of a person ("Inspector"): filled when a project is made from it.
model ProjectTemplateRole {
  id         String                @id @default(cuid())
  templateId String
  name       String                @db.VarChar(80)
  position   Int                   @default(0)
  template   ProjectTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks      ProjectTemplateTask[]

  @@index([templateId])
  @@map("project_template_roles")
}

/// One of a template's standard tasks, due `dueOffsetDays` calendar days after the project's start.
model ProjectTemplateTask {
  id            String               @id @default(cuid())
  templateId    String
  position      Int                  @default(0)
  title         String               @db.VarChar(191)
  description   String?              @db.Text
  priority      Priority             @default(NORMAL)
  /// Days after the project's start it is due (0 = the start day, negative = before it); null = no due date.
  dueOffsetDays Int?
  /// The role whose person does it; null = the project's usual default (its owner).
  roleId        String?
  /// Its checklist items' text, in order.
  checklist     Json
  template      ProjectTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  role          ProjectTemplateRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([templateId, position])
  @@index([roleId])
  @@map("project_template_tasks")
}

/// A starting point for one task: fills in the New task form's title, description, checklist and priority.
model TaskTemplate {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(191)
  title       String   @db.VarChar(191)
  description String?  @db.Text
  priority    Priority @default(NORMAL)
  /// Its checklist items' text, in order.
  checklist   Json
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
  @@map("task_templates")
}

// ---------------------------------------------------------------------------
// Inspection checklists
// ---------------------------------------------------------------------------

/// A checklist template: sections of Pass / Fail / N/A items and readings with limits, and the
/// signatures it asks for. Administrators manage every form; whoever runs a project can create
/// forms and edit or delete their own. Deleting one keeps every inspection made from it.
model InspectionForm {
  id                  String       @id @default(cuid())
  title               String       @db.VarChar(150)
  description         String?      @db.Text
  /// The sections and their items (inspection-rules FormSection[]), checked on the way in.
  sections            Json
  /// NONE, OPTIONAL or REQUIRED: a client's / a supervisor's signature besides the inspector's.
  clientSignature     String       @default("NONE") @db.VarChar(10)
  supervisorSignature String       @default("NONE") @db.VarChar(10)
  /// Goes up with each edit (an edit made from an older copy is refused).
  version             Int          @default(1)
  /// Who made it (a staff user id; kept when that person is gone).
  createdById         String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  inspections         Inspection[]
  /// Tasks that carry this form (scheduled checks and one-off tasks).
  tasks               Task[]       @relation("TaskInspectionForm")

  @@index([deletedAt])
  @@map("inspection_forms")
}

/// One inspection carried out on a project, from a form. The form's checklist is copied in when it
/// starts (`structure`), so editing or deleting the form never changes it. One inspector at a time
/// answers it; finishing signs it and makes it read-only (someone who runs the project may reopen it,
/// which takes the signatures off).
model Inspection {
  id                     String                @id @default(cuid())
  projectId              String
  formId                 String?
  formVersion            Int
  title                  String                @db.VarChar(150)
  description            String?               @db.Text
  /// The form's sections and signature rules as they were when it started.
  structure              Json
  place                  String?               @db.VarChar(200)
  /// The task it was carried out for ("Inspect rig 3"), if any.
  taskId                 String?
  /// Recycle Bin: that task was erased — its number and title as they were ("KEY-12 'Inspect rig 3'"),
  /// so the report still says which task it was carried out for.
  erasedTask             String?               @db.VarChar(300)
  /// IN_PROGRESS or FINISHED.
  status                 String                @default("IN_PROGRESS") @db.VarChar(12)
  /// The one person who answers it now (whoever started it, or took it over).
  inspectorId            String
  startedById            String
  startedAt              DateTime              @default(now())
  finishedAt             DateTime?
  /// The device's id for the finish that was applied: sending the same finish again is a no-op.
  finishId               String?               @db.VarChar(64)
  /// Goes up with each reopen: a finish signed before a reopen (a reply lost, then sent again) is refused.
  revision               Int                   @default(0)
  /// The last reopen: when, and who (the staff report says so; the client's copy says only when).
  reopenedAt             DateTime?
  reopenedById           String?
  /// Counts as of finishing (and kept up to date while in progress), for lists.
  itemCount              Int                   @default(0)
  passedCount            Int                   @default(0)
  failedCount            Int                   @default(0)
  naCount                Int                   @default(0)
  /// A finished report shown on the project's client page. Cleared on reopen.
  clientVisible          Boolean               @default(false)
  /// The project it was shown to the client of: shown only while it is still that project's.
  clientVisibleProjectId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?
  project                Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  form                   InspectionForm?       @relation(fields: [formId], references: [id], onDelete: SetNull)
  task                   Task?                 @relation("InspectionTask", fields: [taskId], references: [id], onDelete: SetNull)
  answers                InspectionAnswer[]
  signatures             InspectionSignature[]
  followUps              InspectionFollowUp[]

  @@index([projectId, deletedAt])
  @@index([taskId])
  @@map("inspections")
}

/// An inspection item's answer. One row per item; a write is kept only when it was made later on its
/// device than the one stored (`editedAt`), so a late, repeated or out-of-order send changes nothing.
model InspectionAnswer {
  id           String     @id @default(cuid())
  inspectionId String
  itemId       String     @db.VarChar(40)
  /// PASS, FAIL or NA (a reading's is worked out from its limits, never taken as sent); null: unanswered.
  result       String?    @db.VarChar(4)
  /// The reading as typed (a plain decimal).
  reading      String?    @db.VarChar(32)
  note         String?    @db.Text
  /// When it was changed on the device that sent it.
  editedAt     DateTime   @db.DateTime(3)
  answeredById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, itemId])
  @@map("inspection_answers")
}

/// A signature on a finished inspection: drawn (a PNG) or typed (the name alone), with the signer's
/// typed name and when they signed. Written only together with finishing; a reopen marks it superseded
/// (kept, and listed on the staff report as an earlier signed revision).
model InspectionSignature {
  id           String     @id @default(cuid())
  inspectionId String
  /// INSPECTOR, CLIENT or SUPERVISOR.
  role         String     @db.VarChar(12)
  name         String     @db.VarChar(120)
  /// DRAWN or TYPED.
  method       String     @db.VarChar(6)
  image        Bytes?     @db.MediumBlob
  signedAt     DateTime
  /// The staff member whose device took it.
  capturedById String
  /// The inspection's revision it signed; a reopen keeps it, marked superseded (an earlier signed revision).
  revision     Int        @default(0)
  supersededAt DateTime?
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@unique([inspectionId, revision, role])
  @@map("inspection_signatures")
}

/// The follow-up task made from a failed item: at most one per item (the unique key makes a double
/// tap or a replayed request return the same task).
model InspectionFollowUp {
  id           String     @id @default(cuid())
  inspectionId String
  itemId       String     @db.VarChar(40)
  /// Null only while its task is being made.
  taskId       String?    @unique
  createdById  String
  createdAt    DateTime   @default(now())
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  task         Task?      @relation("InspectionFollowUpTask", fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([inspectionId, itemId])
  @@map("inspection_follow_ups")
}

// ─────────────────────────────── Backups ───────────────────────────────
// docs/BACKUPS.md. The copies are files in BACKUP_DIR; this table says how each one went. Retention
// deletes a copy's file and its row together.

enum BackupTrigger {
  NIGHTLY
  MANUAL
}

enum BackupStatus {
  RUNNING
  OK
  FAILED
}

enum BackupDriveStatus {
  UPLOADED
  FAILED
  SKIPPED
}

/// One backup copy (or a try at one): the nightly copy, or "Back up now" in System Settings.
model BackupRun {
  id            String             @id @default(cuid())
  trigger       BackupTrigger
  status        BackupStatus       @default(RUNNING)
  /// The company date it was made on ('YYYY-MM-DD').
  localDate     String             @db.VarChar(10)
  startedAt     DateTime           @default(now())
  finishedAt    DateTime?
  /// The copy's file name in BACKUP_DIR (once made).
  fileName      String?            @db.VarChar(191)
  sizeBytes     BigInt?
  sha256        String?            @db.Char(64)
  encrypted     Boolean            @default(false)
  tableCount    Int?
  rowCount      Int?
  fileCount     Int?
  /// Why it failed, in plain words.
  error         String?            @db.Text
  /// The Google Drive copy: null when Drive isn't connected.
  driveStatus   BackupDriveStatus?
  driveFileId   String?            @db.VarChar(191)
  driveError    String?            @db.Text
  /// Who pressed "Back up now" (a plain id, so the row outlives the person).
  requestedById String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, startedAt])
  @@index([localDate])
  @@map("backup_runs")
}

/// 1.22.4 Error log (System Settings → Error log): one row per distinct error — what browsers report
/// (errors, network problems, blocked files and scripts, slow pages) and the server's own (failed
/// requests, background jobs). The same error is one row: `fingerprint` is a sha-256 of its kind, its
/// message with numbers and ids normalised, and the site's own top frame (original file + function).
/// Kept 30 days after it was last seen.
model ErrorGroup {
  id             String       @id @default(cuid())
  fingerprint    String       @unique @db.Char(64)
  /// ERROR, NETWORK, BLOCKED, SLOW or SERVER.
  kind           String       @db.VarChar(16)
  /// What happened, in the words of its latest occurrence (secrets taken out).
  title          String       @db.VarChar(500)
  /// The site's own top frame: its original file (src/pages/BoardPage.tsx), the latest line, the function.
  topFile        String?      @db.VarChar(300)
  topLine        Int?
  topFunction    String?      @db.VarChar(120)
  count          Int          @default(0)
  /// The distinct people it happened to (plain ids, at most 500) and how many.
  people         Json?
  peopleCount    Int          @default(0)
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  /// The newest version it happened in.
  lastVersion    String?      @db.VarChar(32)
  /// OPEN, or FIXED ("Mark as fixed": hidden until it happens again in a newer version).
  status         String       @default("OPEN") @db.VarChar(8)
  fixedAt        DateTime?
  fixedById      String?
  fixedInVersion String?      @db.VarChar(32)
  /// When it came back after being marked fixed.
  reopenedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  events         ErrorEvent[]

  @@index([lastSeenAt])
  @@index([status, kind, lastSeenAt])
  @@map("error_groups")
}

/// One occurrence of an error-log row (each row keeps its 20 newest). Never typed text, form values,
/// tokens, cookies, storage or request bodies: the page's route as a pattern, the browser and system
/// in two words, the screen size, the signed-in person's id (a plain id: the row outlives the person).
model ErrorEvent {
  id        String     @id @default(cuid())
  groupId   String
  at        DateTime
  kind      String     @db.VarChar(16)
  /// error, rejection, boundary, chunk · api, socket · resource, csp, csp-report · load, lcp, inp, cls · request, job, background.
  detail    String?    @db.VarChar(32)
  message   String     @db.VarChar(500)
  /// The stack with the site's original file:line (trimmed to 4 KB).
  stack     String?    @db.Text
  /// The page's route pattern (/projects/:id); a failed request's "GET /api/v1/…" route.
  page      String?    @db.VarChar(300)
  /// A background job's name (server errors).
  job       String?    @db.VarChar(100)
  /// A blocked file or address, or a slow request.
  resource  String?    @db.VarChar(300)
  /// Milliseconds, or the layout-shift score.
  value     Float?
  count     Int        @default(1)
  version   String?    @db.VarChar(32)
  browser   String?    @db.VarChar(60)
  system    String?    @db.VarChar(40)
  screen    String?    @db.VarChar(20)
  userId    String?
  signedIn  Boolean    @default(false)
  createdAt DateTime   @default(now())
  group     ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, at])
  @@index([at])
  @@map("error_events")
}

// ---------------------------------------------------------------------------
// Project KPIs and User KPIs. The automatic KPIs are worked out from tasks and their history
// (modules/kpis); these tables hold what can't be: a project's own KPIs and their monthly values, the
// targets (company defaults, project overrides), and weekly snapshots so trends don't change when old
// tasks are edited.
// ---------------------------------------------------------------------------

/// A project's own KPI (owner 1: name, unit, target, values entered each month), e.g. "Safety incidents".
model ProjectKpi {
  id          String            @id @default(cuid())
  projectId   String
  name        String            @db.VarChar(80)
  /// Free text shown after the value ("%", "incidents", "OMR").
  unit        String            @default("") @db.VarChar(24)
  /// 'HIGHER' or 'LOWER' is better.
  direction   String            @default("HIGHER") @db.VarChar(8)
  /// Null: no target (no light).
  target      Float?
  /// Null: 10% of the target.
  amberBand   Float?
  position    Int               @default(0)
  createdById String?           @db.VarChar(191)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values      ProjectKpiValue[]

  @@index([projectId])
  @@map("project_kpis")
}

/// One month's value of a project's own KPI ('YYYY-MM'), with an optional note and who entered it.
model ProjectKpiValue {
  id          String     @id @default(cuid())
  kpiId       String
  month       String     @db.VarChar(7)
  value       Float
  note        String?    @db.VarChar(500)
  enteredById String?    @db.VarChar(191)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  kpi         ProjectKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([kpiId, month])
  @@map("project_kpi_values")
}

/// A KPI target: the site's default ('site'), a company's ('company:<id>', administrators) or a project's
/// override ('project:<id>', whoever runs it). A row with no target means "no target here". No row: the
/// next level up decides (project → company → site → the built-in default).
model KpiTarget {
  id          String   @id @default(cuid())
  scopeKey    String   @db.VarChar(200)
  metric      String   @db.VarChar(40)
  target      Float?
  /// Null: 10% of the target.
  amberBand   Float?
  updatedById String?  @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scopeKey, metric])
  @@map("kpi_targets")
}

/// The KPIs' counters for one slice (a week cut at a month's end) of one project — its own row (userId '')
/// and one row per person with something counted. Written nightly (the last two closed months again, older
/// months frozen); at launch the past six months are rebuilt from task dates and history (`rebuilt`).
model KpiSnapshot {
  id         String   @id @default(cuid())
  projectId  String   @db.VarChar(191)
  userId     String   @default("") @db.VarChar(191)
  /// The slice's first and last day, its week's first day and its month.
  day        String   @db.VarChar(10)
  endDay     String   @db.VarChar(10)
  weekStart  String   @db.VarChar(10)
  month      String   @db.VarChar(7)
  metrics    Json
  rebuilt    Boolean  @default(false)
  computedAt DateTime @default(now())

  @@unique([projectId, userId, day])
  @@index([month])
  @@index([userId, month])
  @@map("kpi_snapshots")
}

// ── Training Center (owner, 11 Nov 2026) ───────────────────────────────────────────────────────────────
// Courses are site-wide (like Templates) and may be limited to companies; staff courses for the modules a
// person can use, client courses in the Client portal only. People are referenced by id (no foreign keys,
// as the KPI tables): accounts are soft-deleted. Files live in a private folder beside the uploads (never
// the public /uploads path) and are served after the course's audience check.

/// A course: ordered lessons, optional certificate, its audience and the module it teaches.
model TrainingCourse {
  id                String           @id @default(cuid())
  title             String           @db.VarChar(160)
  summary           String?          @db.Text
  /// tasks | board | meetings | calendar | projects | reports | management | chat | mico-ai | admin | portal | training | general
  moduleKey         String           @db.VarChar(24)
  /// 'STAFF' | 'CLIENTS'
  audience          String           @default("STAFF") @db.VarChar(8)
  /// Staff groups it is for (['admins','employees','project-runners','training-managers']); null or empty: everyone.
  roleKeys          Json?
  /// 'BEGINNER' | 'INTERMEDIATE' | 'ADVANCED'
  difficulty        String           @default("BEGINNER") @db.VarChar(16)
  /// 'DRAFT' | 'PUBLISHED' | 'ARCHIVED'
  status            String           @default("DRAFT") @db.VarChar(12)
  /// 'ALL_LESSONS' (every lesson done; a quiz is done when passed) | 'QUIZZES' (passing every quiz is enough)
  completionRule    String           @default("ALL_LESSONS") @db.VarChar(16)
  /// Lessons must be finished in order.
  inOrder           Boolean          @default(false)
  certificateOn     Boolean          @default(false)
  /// A certificate's validity in months; null: it never expires.
  certificateMonths Int?
  /// "Issued by" on the certificate: a Training manager or administrator, their title and an optional signature picture.
  issuerUserId      String?          @db.VarChar(191)
  issuerTitle       String?          @db.VarChar(120)
  signatureFileId   String?          @db.VarChar(191)
  /// Limited to these companies (JSON array of ids); null or empty: every company.
  companyIds        Json?
  /// Raised by every publish after the first; a "Major change" also stamps majorAt (completions before it review).
  version           Int              @default(1)
  majorAt           DateTime?
  /// Starter content (loaded once by the server); null for courses people made.
  starterKey        String?          @unique @db.VarChar(64)
  position          Int              @default(0)
  createdById       String?          @db.VarChar(191)
  updatedById       String?          @db.VarChar(191)
  publishedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lessons           TrainingLesson[]
  modules           TrainingModule[]

  @@index([status])
  @@index([moduleKey])
  @@map("training_courses")
}

/// One lesson of a course: a video (YouTube / Vimeo link), a step-by-step guide, a document or a quiz.
model TrainingLesson {
  id             String         @id @default(cuid())
  courseId       String         @db.VarChar(191)
  position       Int            @default(0)
  /// 'VIDEO' | 'GUIDE' | 'DOCUMENT' | 'QUIZ'
  kind           String         @db.VarChar(12)
  title          String         @db.VarChar(160)
  minutes        Int            @default(5)
  /// An introduction (server-cleaned rich text).
  body           String?        @db.Text
  /// VIDEO: 'YOUTUBE' | 'VIMEO', the video's id, an unlisted Vimeo video's hash and the link as entered.
  videoProvider  String?        @db.VarChar(8)
  videoId        String?        @db.VarChar(32)
  videoHash      String?        @db.VarChar(32)
  videoUrl       String?        @db.VarChar(500)
  /// DOCUMENT: its file (training_files).
  fileId         String?        @db.VarChar(191)
  /// The course version this lesson last changed in by a "Major change" (people who finished before review it).
  changedVersion Int            @default(1)
  /// The module of the course this lesson belongs to (Learning Hub one course, 1.23.30); null: none.
  moduleId       String?        @db.VarChar(191)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  course         TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  steps          TrainingStep[]
  quiz           TrainingQuiz?

  @@index([courseId, position])
  @@index([moduleId])
  @@map("training_lessons")
}

/// A guide lesson's numbered step: text and an optional picture.
model TrainingStep {
  id          String         @id @default(cuid())
  lessonId    String         @db.VarChar(191)
  position    Int            @default(0)
  title       String?        @db.VarChar(160)
  body        String?        @db.Text
  imageFileId String?        @db.VarChar(191)
  imageAlt    String?        @db.VarChar(200)
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, position])
  @@map("training_steps")
}

/// A training file in the private training folder: a course download, a document lesson's file, a guide
/// step's picture or a certificate signature.
model TrainingFile {
  id           String   @id @default(cuid())
  /// The course it belongs to; null: a signature picture.
  courseId     String?  @db.VarChar(191)
  /// 'RESOURCE' | 'DOCUMENT' | 'IMAGE' | 'SIGNATURE'
  kind         String   @db.VarChar(12)
  name         String   @db.VarChar(180)
  mimeType     String   @db.VarChar(100)
  sizeBytes    Int
  storageKey   String   @unique @db.VarChar(200)
  position     Int      @default(0)
  starter      Boolean  @default(false)
  uploadedById String?  @db.VarChar(191)
  createdAt    DateTime @default(now())

  @@index([courseId, kind])
  @@map("training_files")
}

/// A quiz lesson's settings.
model TrainingQuiz {
  id               String             @id @default(cuid())
  lessonId         String             @unique @db.VarChar(191)
  /// Percent needed to pass.
  passMark         Int                @default(70)
  /// Attempts allowed; null: unlimited.
  maxAttempts      Int?
  shuffle          Boolean            @default(false)
  timeLimitMinutes Int?
  /// Question bank: draw this many questions at random for each attempt; null: every question.
  drawCount        Int?
  lesson           TrainingLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions        TrainingQuestion[]

  @@map("training_quizzes")
}

model TrainingQuestion {
  id          String           @id @default(cuid())
  quizId      String           @db.VarChar(191)
  position    Int              @default(0)
  /// 'SINGLE' | 'MULTIPLE' | 'TRUE_FALSE' | 'ORDER' (options' positions are the right order)
  kind        String           @db.VarChar(12)
  prompt      String           @db.Text
  /// Said after the attempt (why the answer is right).
  explanation String?          @db.Text
  quiz        TrainingQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     TrainingOption[]

  @@index([quizId, position])
  @@map("training_questions")
}

model TrainingOption {
  id         String           @id @default(cuid())
  questionId String           @db.VarChar(191)
  position   Int              @default(0)
  text       String           @db.VarChar(500)
  correct    Boolean          @default(false)
  /// Feedback shown after the attempt when this answer was chosen.
  feedback   String?          @db.VarChar(500)
  question   TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@map("training_options")
}

/// An assignment of a course to a person or a group (group assignments follow membership).
model TrainingAssignment {
  id              String    @id @default(cuid())
  courseId        String    @db.VarChar(191)
  /// 'USER' | 'GROUP' | 'DEPARTMENT' | 'COMPANY' | 'PROJECT'
  targetKind      String    @db.VarChar(12)
  /// The person, group key (everyone | admins | employees | clients | project-runners | training-managers),
  /// department, company or project.
  targetId        String    @db.VarChar(191)
  mandatory       Boolean   @default(true)
  /// A fixed due day ('YYYY-MM-DD') or N days after each person got it; neither: no due date.
  dueDay          String?   @db.VarChar(10)
  dueDays         Int?
  /// An onboarding rule's assignment: only accounts made after it was set up get it.
  ruleId          String?   @db.VarChar(191)
  newAccountsOnly Boolean   @default(false)
  /// A Training manager's companies when they assigned it (only people there get it); null: everyone.
  scopeCompanyIds Json?
  /// Stopped following membership (a rule switched off): nobody new gets it, nobody loses it.
  frozenAt        DateTime?
  /// Assignments made together (one grouped request) share a batch id.
  batchId         String?   @db.VarChar(191)
  createdById     String?   @db.VarChar(191)
  createdAt       DateTime  @default(now())
  withdrawnAt     DateTime?
  withdrawnById   String?   @db.VarChar(191)

  @@index([courseId])
  @@index([ruleId])
  @@index([batchId])
  @@index([withdrawnAt])
  @@map("training_assignments")
}

/// Who an assignment reached, from when, with their own due day.
model TrainingAssignee {
  id           String    @id @default(cuid())
  assignmentId String    @db.VarChar(191)
  userId       String    @db.VarChar(191)
  courseId     String    @db.VarChar(191)
  mandatory    Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  dueDay       String?   @db.VarChar(10)
  withdrawnAt  DateTime?

  @@unique([assignmentId, userId])
  @@index([userId, courseId])
  @@index([courseId])
  @@map("training_assignees")
}

/// A person's course: started, progress, completion, a review after a Major change, a retake after expiry.
model TrainingEnrolment {
  id               String    @id @default(cuid())
  userId           String    @db.VarChar(191)
  courseId         String    @db.VarChar(191)
  /// Started from the catalogue (kept when assignments are withdrawn).
  selfStarted      Boolean   @default(false)
  startedAt        DateTime?
  completedAt      DateTime?
  completedVersion Int?
  progressPct      Int       @default(0)
  lastLessonId     String?   @db.VarChar(191)
  lastActivityAt   DateTime?
  /// After a Major change: review the changed lessons by this day (lessons done since reviewFrom count).
  reviewFrom       DateTime?
  reviewDueDay     String?   @db.VarChar(10)
  reviewDoneAt     DateTime?
  /// The certificate expired: lessons and quizzes count again only from this moment.
  retakeFrom       DateTime?
  /// Unfinished and no assignment left (and not started by themselves): hidden from My training.
  withdrawnAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("training_enrolments")
}

/// Per person per lesson: done, the video position, the guide step (saved automatically).
model TrainingProgress {
  id            String    @id @default(cuid())
  userId        String    @db.VarChar(191)
  courseId      String    @db.VarChar(191)
  lessonId      String    @db.VarChar(191)
  doneAt        DateTime?
  videoSeconds  Int       @default(0)
  videoDuration Int?
  watchedPct    Int       @default(0)
  stepIndex     Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, courseId])
  @@map("training_progress")
}

/// One quiz attempt: the paper drawn for it (questions, option order and right answers - never sent to the
/// browser before it is handed in), the answers, the mark.
model TrainingAttempt {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(191)
  courseId    String    @db.VarChar(191)
  lessonId    String    @db.VarChar(191)
  quizId      String    @db.VarChar(191)
  paper       Json
  answers     Json?
  startedAt   DateTime  @default(now())
  deadlineAt  DateTime?
  submittedAt DateTime?
  scorePct    Int?
  passed      Boolean?

  @@index([userId, lessonId])
  @@index([quizId])
  @@index([courseId])
  @@map("training_attempts")
}

/// A certificate: verifiable by its code (the public page shows only course, name, dates and status).
model TrainingCertificate {
  id              String    @id @default(cuid())
  code            String    @unique @db.VarChar(24)
  userId          String    @db.VarChar(191)
  courseId        String    @db.VarChar(191)
  learnerName     String    @db.VarChar(200)
  courseTitle     String    @db.VarChar(160)
  /// The learner's company (its logo and name on the PDF); null: the site's.
  companyId       String?   @db.VarChar(191)
  scorePct        Int?
  issuerName      String?   @db.VarChar(200)
  issuerTitle     String?   @db.VarChar(120)
  signatureFileId String?   @db.VarChar(191)
  issuedAt        DateTime  @default(now())
  /// The day the last needed module was finished (printed on the certificate); null: use issuedAt.
  completedAt     DateTime?
  /// The modules the certificate covers (JSON array of module ids); null: not recorded.
  moduleIds       Json?
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedReason   String?   @db.VarChar(200)
  revokedById     String?   @db.VarChar(191)

  @@index([userId])
  @@index([courseId])
  @@index([expiresAt])
  @@map("training_certificates")
}

/// A module of a course (Learning Hub one course, 1.23.30): the group of lessons and a quiz for one feature.
model TrainingModule {
  id           String         @id @default(cuid())
  courseId     String         @db.VarChar(191)
  position     Int            @default(0)
  title        String         @db.VarChar(160)
  /// The feature it teaches (visibility follows feature access).
  moduleKey    String         @default("general") @db.VarChar(24)
  /// Staff groups it is for; null or empty: everyone.
  roleKeys     Json?
  /// Limited to these companies (JSON array of ids); null or empty: every company.
  companyIds   Json?
  /// Off: hidden from learners and not needed for completion.
  enabled      Boolean        @default(true)
  /// Why it is off: 'REMOVED' (the site removed the feature); null otherwise.
  offReason    String?        @db.VarChar(16)
  /// Built-in modules ('module:tasks' ...); null for modules people made.
  starterKey   String?        @db.VarChar(64)
  /// The built-in short course this module replaced.
  fromCourseId String?        @db.VarChar(191)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, starterKey])
  @@index([courseId, position])
  @@map("training_modules")
}

/// A person finished a module (recorded, so a module appearing or changing later never undoes it).
model TrainingModuleDone {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(191)
  courseId  String   @db.VarChar(191)
  moduleId  String   @db.VarChar(191)
  doneAt    DateTime
  /// 'LEARNED' | 'CONVERTED' (carried over from a short course)
  via       String   @default("LEARNED") @db.VarChar(12)
  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
  @@index([userId, courseId])
  @@index([courseId])
  @@map("training_module_done")
}

/// An onboarding rule: new accounts in a group get these courses (one assignment per course, ruleId).
model TrainingRule {
  id              String   @id @default(cuid())
  name            String   @db.VarChar(120)
  /// 'GROUP' | 'DEPARTMENT' | 'COMPANY'
  targetKind      String   @db.VarChar(12)
  targetId        String   @db.VarChar(191)
  courseIds       Json
  mandatory       Boolean  @default(true)
  dueDays         Int?
  active          Boolean  @default(true)
  scopeCompanyIds Json?
  createdById     String?  @db.VarChar(191)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("training_rules")
}

/// Ratings, questions and "outdated" reports on a course or one of its lessons.
model TrainingFeedback {
  id           String    @id @default(cuid())
  courseId     String    @db.VarChar(191)
  lessonId     String?   @db.VarChar(191)
  userId       String    @db.VarChar(191)
  /// 'RATING' | 'QUESTION' | 'OUTDATED'
  kind         String    @db.VarChar(12)
  rating       Int?
  body         String?   @db.Text
  /// 'OPEN' | 'ANSWERED' | 'FIXED' (a rating is ANSWERED from the start: nothing to do)
  status       String    @default("OPEN") @db.VarChar(12)
  answer       String?   @db.Text
  answeredById String?   @db.VarChar(191)
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([courseId, kind])
  @@index([status, kind])
  @@index([userId])
  @@map("training_feedback")
}

/// Bulk task changes (bulk lane): one row per bulk action someone applied — for its Undo (each task's
/// values before and after, read back only by the person who made it, within its window) and the audit.
model TaskBulkAction {
  id        String    @id @default(cuid())
  actorId   String
  /// status | priority | assign | reassign | unassign | dueDate | project | category | guests | duplicate | archive | unarchive | delete
  action    String    @db.VarChar(32)
  /// How many tasks it changed.
  changed   Int       @default(0)
  /// Each changed task's before/after values (and copies made, a delete's batch) — what Undo puts back.
  undoData  Json?
  createdAt DateTime  @default(now())
  /// Undo is refused after this.
  undoUntil DateTime
  /// When it was undone (once only).
  undoneAt  DateTime?

  @@index([actorId, createdAt])
  @@map("task_bulk_actions")
}
