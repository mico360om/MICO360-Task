# ---- Database (MySQL 8) ----
DATABASE_URL="mysql://mico:mico@localhost:3306/mico360"
# Separate database used by the integration test suite
TEST_DATABASE_URL="mysql://mico:mico@localhost:3306/mico360_test"

# ---- Server ----
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed origins (web app + extension)
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL_SECONDS=900
# 30 days — clients stay signed in for a month via silent refresh.
JWT_REFRESH_TTL_SECONDS=2592000
ACCOUNT_LOCK_MAX_ATTEMPTS=5
OTP_TTL_SECONDS=600
OTP_LENGTH=6
# Password-reset link lifetime (seconds) + the web app URL used to build the reset link
PASSWORD_RESET_TTL_SECONDS=3600
APP_URL=http://localhost:5173

# ---- Email (Mailjet) — leave blank here; put real values only in .env (git-ignored) ----
# NOTE: rotate the Mailjet secret before production; never commit real keys.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=25
MAIL_FROM="MICO360 Tasks <no-reply@mico360.example>"

# ---- Email branding (shown in every outgoing email header/footer) ----
COMPANY_NAME=MICO360
PRODUCT_NAME="MICO360 Tasks"
SUPPORT_EMAIL=support@mico360.example
COMPANY_WEBSITE_URL=https://mico360.example
COMPANY_ADDRESS="MICO360, Muscat, Sultanate of Oman"
# Company time zone (IANA name) — the single source of truth for all date/time display.
COMPANY_TIMEZONE=Asia/Muscat
# Optional hosted logo (PNG, ~150px wide). Blank = branded text wordmark.
EMAIL_LOGO_URL=

# ---- File attachments ----
# Directory (relative to the backend cwd) where uploaded files are stored on disk.
UPLOAD_DIR=uploads
# Max upload size in bytes (default 10 MiB).
UPLOAD_MAX_BYTES=10485760
# Comma-separated list of allowed MIME types.
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/csv,application/zip
