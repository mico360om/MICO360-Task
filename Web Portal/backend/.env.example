# ---- Database (MySQL 8) ----
DATABASE_URL="mysql://mico:mico@localhost:3306/mico360"
# Separate database used by the integration test suite
TEST_DATABASE_URL="mysql://mico:mico@localhost:3306/mico360_test"

# ---- Server ----
PORT=4000
# Interface to listen on: 0.0.0.0 (all, default) or 127.0.0.1 (this computer only).
HOST=0.0.0.0
NODE_ENV=development
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed origins (web app + extension)
CORS_ORIGINS=http://localhost:5173
# Reverse proxies trusted for the real client IP: 'loopback' (nginx/LiteSpeed on the same host),
# a hop count, IPs/CIDRs, 'true' or 'false'. Without it every user shares one rate-limit bucket.
TRUST_PROXY=loopback
# Requests per minute per signed-in user (per IP when signed out), and per IP for sign-in routes.
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL_SECONDS=900
# 30 days — clients stay signed in for a month via silent refresh.
JWT_REFRESH_TTL_SECONDS=2592000
ACCOUNT_LOCK_MAX_ATTEMPTS=5
# First lockout length in minutes; each further lockout doubles it (max 24 h).
ACCOUNT_LOCK_MINUTES=15
# Encrypts secrets stored in the database (AI provider API keys). 32+ random characters.
# Set it before go-live and never change it afterwards (blank = derived from JWT_ACCESS_SECRET).
SECRETS_ENCRYPTION_KEY=
OTP_TTL_SECONDS=600
OTP_LENGTH=6
# Password-reset link lifetime (seconds) + the web app URL used to build the reset link
PASSWORD_RESET_TTL_SECONDS=3600
APP_URL=http://localhost:5173

# ---- Email (Mailjet) — leave blank here; put real values only in .env (git-ignored) ----
# NOTE: rotate the Mailjet secret before production; never commit real keys.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SMTP_HOST=in-v3.mailjet.com
MAILJET_SMTP_PORT=25
MAIL_FROM="MICO360 Tasks <no-reply@mico360.example>"
# Shared secret for the Mailjet event webhook (?token=...). Required in production.
MAILJET_WEBHOOK_TOKEN=

# ---- Phone push (FCM HTTP v1) — a Firebase service-account key; push is off while blank ----
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# ---- AI features ----
# Allow an AI provider on a private/internal network address (e.g. a local Ollama).
AI_ALLOW_PRIVATE_HOSTS=false
# Per-user AI budget.
AI_USER_REQUESTS_PER_MINUTE=10
AI_USER_REQUESTS_PER_DAY=200

# ---- Email branding (shown in every outgoing email header/footer) ----
COMPANY_NAME=MICO360
PRODUCT_NAME="MICO360 Tasks"
SUPPORT_EMAIL=support@mico360.example
COMPANY_WEBSITE_URL=https://mico360.example
COMPANY_ADDRESS="MICO360, Muscat, Sultanate of Oman"
# Company time zone (IANA name) — the single source of truth for all date/time display.
COMPANY_TIMEZONE=Asia/Muscat
# Link for the sign-in page's "Download for Android" (e.g. /downloads/MICO360-Tasks.apk after uploading
# the APK to the web root, or a Play Store URL). Blank = the public GitHub releases page.
ANDROID_APP_URL=
# Optional hosted logo (PNG, ~150px wide). Blank = branded text wordmark.
EMAIL_LOGO_URL=

# ---- File attachments ----
# Built web app (Web Portal/frontend/dist) to serve from this API server — only when no reverse proxy
# serves it (the self-contained Windows server sets this). Blank on Hostinger/nginx.
WEB_ROOT=
# Directory where uploaded files are stored on disk. Use an ABSOLUTE path outside the app folder
# in production (deploy.sh defaults it to $HOME/mico360-data/uploads) so redeploys keep the files.
UPLOAD_DIR=uploads
# Max upload size in bytes (default 10 MiB).
UPLOAD_MAX_BYTES=10485760
# Max total attachment bytes per task (default 50 MiB).
UPLOAD_MAX_TOTAL_BYTES_PER_TASK=52428800
# Comma-separated list of allowed MIME types.
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,text/csv,application/zip
