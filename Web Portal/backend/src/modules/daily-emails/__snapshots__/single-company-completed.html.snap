<!DOCTYPE html><html lang="en" dir="ltr" xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="X-UA-Compatible" content="IE=edge"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><title>MICO360 Tasks</title><style>
  body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
  img{border:0;line-height:100%;outline:none;text-decoration:none}
  a{color:#8B1E1E}
  @media (max-width:620px){
    .email-container{width:100%!important}
    .email-pad{padding-left:18px!important;padding-right:18px!important}
    .email-button a{display:block!important;text-align:center!important}
    .email-heading{font-size:22px!important}
    .email-main{display:block!important;width:auto!important}
    .email-stack{display:block!important;width:auto!important;padding:10px 0 0!important;text-align:left!important}
    .email-head-note{display:none!important}
  }
  @media (prefers-color-scheme:dark){
    body,.email-body{background:#141110!important}
    .email-container,.email-card{background:#1E1A19!important}
    .email-heading{color:#F4F2F0!important}
    .email-text,.email-details td.email-text{color:#E7E1DE!important}
    .email-muted{color:#B8ADA9!important}
    .email-code{background:#26211F!important;border-color:#3A312E!important}
    .email-details{border-color:#3A312E!important}
    .email-details tr{background:#1E1A19!important}
    .email-divider{border-color:#3A312E!important}
    .email-footer{background:#141110!important}
    .email-footer-ink,.email-footer-ink a{color:#9B908B!important}
    .email-proj{background:#26211F!important;border-bottom-color:#3A312E!important}
    .email-proj tr{background:transparent!important}
    .email-card{border-top-color:#3A312E!important}
    .email-link{color:#F0A79B!important;border-color:#F0A79B!important}
    .email-chip-neutral{background:#332C2A!important;color:#E7E1DE!important}
    .email-chip-outline{background:transparent!important;color:#E7E1DE!important;border-color:#5A4E4A!important}
  }
</style></head><body class="email-body" style="margin:0;padding:0;background:#F4F2F0;font-family:Arial,Helvetica,sans-serif"><div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent">3 tasks done on Tue 20 Oct.&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-body" style="background:#F4F2F0"><tr><td align="center" style="padding:24px 12px"><!--[if mso]><table role="presentation" width="720" align="center" cellpadding="0" cellspacing="0"><tr><td><![endif]--><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-container" style="width:100%;max-width:720px;background:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px -12px rgba(33,27,26,0.25)"><!-- Header: one slim line (logo or the email's own identity; an optional note such as the date) --><tr><td style="background:#8B1E1E;background:linear-gradient(135deg,#A83326 0%,#8B1E1E 55%,#5E1414 100%);padding:12px 32px" class="email-pad"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="left" style="vertical-align:middle"><span style="font-family:Arial,Helvetica,sans-serif;font-size:20px;font-weight:800;letter-spacing:-0.3px;color:#FFFFFF">MICO<span style="opacity:0.85">360</span> <span style="font-weight:600;opacity:0.9">Tasks</span></span></td><td class="email-head-note" align="right" style="vertical-align:middle;font-size:13px;color:#FFFFFF;opacity:0.9;white-space:nowrap">Wednesday 21 October</td></tr></table></td></tr><!-- Body --><tr><td class="email-card email-pad" style="background:#FFFFFF;padding:28px 32px"><h1 class="email-heading" style="margin:0 0 16px;font-size:24px;line-height:1.25;font-weight:800;color:#211B1A">Completed yesterday</h1><p class="email-text" style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#211B1A">Ada, here are the tasks assigned to you that were completed yesterday, Tue 20 Oct.</p><div style="margin:0 0 22px"><span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#E9F4EE;color:#1f5a3b">1 on time</span> <span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#FBF1E1;color:#7c4f0b">1 late</span></div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-details" style="margin:0 0 20px;border:1px solid #E6DFDC;border-radius:14px;overflow:hidden"><tr><td class="email-proj" style="padding:14px 16px;background:#FAF7F6;border-top:4px solid #3A6EA5;border-bottom:1px solid #E6DFDC"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td width="54" style="vertical-align:top;width:54px"><table role="presentation" cellpadding="0" cellspacing="0"><tr><td width="42" height="42" align="center" bgcolor="#3A6EA5" style="width:42px;height:42px;border-radius:10px;background:#3A6EA5;color:#FFFFFF;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:800;line-height:42px;text-align:center">RI</td></tr></table></td><td class="email-main" style="vertical-align:top"><div dir="auto" class="email-text" style="text-align:left;font-size:17px;font-weight:800;line-height:1.3;color:#211B1A">Rig Inspection</div><div class="email-muted" style="margin-top:3px;font-size:13px;line-height:1.5;color:#6C625F">RIG · No. 2026-014 · Client: Acme Drilling · Manager: Sara Ali · Target Mon 30 Nov</div><div><span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#E9F4EE;color:#1f5a3b">Active</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">2 tasks done</span></div></td><td class="email-stack" width="120" align="right" style="vertical-align:top;width:120px"><a href="https://task.example/projects/p-rig" target="_blank" class="email-link" aria-label="Open project Rig Inspection" style="font-size:13px;font-weight:700;color:#8B1E1E;text-decoration:none;white-space:nowrap">Open project ›</a></td></tr></table></td></tr><tr><td class="email-card" style="padding:14px 16px;background:#FFFFFF"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td class="email-main" style="vertical-align:top"><a href="https://task.example/my-tasks?task=rig-1" target="_blank" dir="auto" class="email-text" style="font-size:16px;font-weight:700;line-height:1.4;color:#211B1A;text-decoration:none">Task RIG-1</a><div class="email-muted" style="margin-top:2px;font-size:13px;color:#6C625F">RIG-1</div><div><span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">Completed Tue 20 Oct, 09:10</span> <span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#E9F4EE;color:#1f5a3b">On time</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">Normal priority</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#6C625F">Due Wed 21 Oct</span></div></td><td class="email-stack" width="90" align="right" style="vertical-align:middle;width:90px"><a href="https://task.example/my-tasks?task=rig-1" target="_blank" class="email-link" aria-label="Open RIG-1" style="display:inline-block;padding:7px 14px;border:1px solid #8B1E1E;border-radius:999px;font-size:13px;font-weight:700;color:#8B1E1E;text-decoration:none;white-space:nowrap">Open ›</a></td></tr></table></td></tr><tr><td class="email-card" style="padding:14px 16px;background:#FFFFFF;border-top:1px solid #E6DFDC"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td class="email-main" style="vertical-align:top"><a href="https://task.example/my-tasks?task=rig-2" target="_blank" dir="auto" class="email-text" style="font-size:16px;font-weight:700;line-height:1.4;color:#211B1A;text-decoration:none">Task RIG-2</a><div class="email-muted" style="margin-top:2px;font-size:13px;color:#6C625F">RIG-2</div><div><span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">Completed Tue 20 Oct, 11:00</span> <span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#FBF1E1;color:#7c4f0b">2 days late</span> <span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#FBF1E1;color:#7c4f0b">High priority</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#6C625F">Due Sun 18 Oct</span></div></td><td class="email-stack" width="90" align="right" style="vertical-align:middle;width:90px"><a href="https://task.example/my-tasks?task=rig-2" target="_blank" class="email-link" aria-label="Open RIG-2" style="display:inline-block;padding:7px 14px;border:1px solid #8B1E1E;border-radius:999px;font-size:13px;font-weight:700;color:#8B1E1E;text-decoration:none;white-space:nowrap">Open ›</a></td></tr></table></td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-details" style="margin:0 0 20px;border:1px solid #E6DFDC;border-radius:14px;overflow:hidden"><tr><td class="email-proj" style="padding:14px 16px;background:#FAF7F6;border-top:4px solid #A83326;border-bottom:1px solid #E6DFDC"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td width="54" style="vertical-align:top;width:54px"><img src="https://api.example/uploads/projects/ops.png" alt="" width="42" height="42" style="display:block;border:0;width:42px;height:42px;border-radius:10px;object-fit:cover;font-family:Arial,Helvetica,sans-serif;font-size:11px"/></td><td class="email-main" style="vertical-align:top"><div dir="auto" class="email-text" style="text-align:left;font-size:17px;font-weight:800;line-height:1.3;color:#211B1A">Operations</div><div class="email-muted" style="margin-top:3px;font-size:13px;line-height:1.5;color:#6C625F">OPS</div><div><span class="email-chip" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#FBF1E1;color:#7c4f0b">On hold</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">1 task done</span></div></td><td class="email-stack" width="120" align="right" style="vertical-align:top;width:120px"><a href="https://task.example/projects/p-ops" target="_blank" class="email-link" aria-label="Open project Operations" style="font-size:13px;font-weight:700;color:#8B1E1E;text-decoration:none;white-space:nowrap">Open project ›</a></td></tr></table></td></tr><tr><td class="email-card" style="padding:14px 16px;background:#FFFFFF"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td class="email-main" style="vertical-align:top"><a href="https://task.example/my-tasks?task=ops-1" target="_blank" dir="auto" class="email-text" style="font-size:16px;font-weight:700;line-height:1.4;color:#211B1A;text-decoration:none">Task OPS-1</a><div class="email-muted" style="margin-top:2px;font-size:13px;color:#6C625F">OPS-1</div><div><span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">Completed Tue 20 Oct, 13:30</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#4A403D">Normal priority</span> <span class="email-chip-neutral" style="display:inline-block;margin:8px 2px 0 0;padding:3px 10px;border-radius:999px;font-size:12px;line-height:18px;font-weight:700;white-space:nowrap;background:#F1EEEC;color:#6C625F">No due date</span></div></td><td class="email-stack" width="90" align="right" style="vertical-align:middle;width:90px"><a href="https://task.example/my-tasks?task=ops-1" target="_blank" class="email-link" aria-label="Open OPS-1" style="display:inline-block;padding:7px 14px;border:1px solid #8B1E1E;border-radius:999px;font-size:13px;font-weight:700;color:#8B1E1E;text-decoration:none;white-space:nowrap">Open ›</a></td></tr></table></td></tr></table><table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 20px" class="email-button"><tr><td align="center" bgcolor="#8B1E1E" style="border-radius:12px;background:#8B1E1E;background:linear-gradient(135deg,#A83326 0%,#8B1E1E 100%)"><a href="https://task.example/my-tasks" target="_blank" style="display:inline-block;padding:13px 28px;font-size:15px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:12px">Open My Tasks</a></td></tr></table><p class="email-text" style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#211B1A">You get this email every morning. To change the time or turn it off, open Settings → Daily task emails: https://task.example/settings</p></td></tr><!-- Footer --><tr><td class="email-footer email-pad" style="background:#F4F2F0;padding:18px 32px;border-top:1px solid #E6DFDC"><p class="email-footer-ink" style="margin:0 0 6px;font-size:13px;color:#8A7F7B"><a href="http://localhost:5173" style="color:#8B1E1E;text-decoration:none;font-weight:600">MICO360 Tasks</a>
