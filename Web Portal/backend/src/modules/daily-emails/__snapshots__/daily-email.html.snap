<!DOCTYPE html><html lang="en" dir="ltr" xmlns="http://www.w3.org/1999/xhtml"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta http-equiv="X-UA-Compatible" content="IE=edge"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><title>MICO360 Tasks</title><style>
  body,table,td,a{-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
  img{border:0;line-height:100%;outline:none;text-decoration:none}
  a{color:#8B1E1E}
  @media (max-width:620px){
    .email-container{width:100%!important}
    .email-pad{padding-left:18px!important;padding-right:18px!important}
    .email-button a{display:block!important;text-align:center!important}
    .email-heading{font-size:22px!important}
    .email-main{display:block!important;width:auto!important}
    .email-stack{display:block!important;width:auto!important;padding:10px 0 0!important;text-align:left!important}
    .email-head-note{display:none!important}
  }
  @media (prefers-color-scheme:dark){
    body,.email-body{background:#141110!important}
    .email-container,.email-card{background:#1E1A19!important}
    .email-heading{color:#F4F2F0!important}
    .email-text,.email-details td.email-text{color:#E7E1DE!important}
    .email-muted{color:#B8ADA9!important}
    .email-code{background:#26211F!important;border-color:#3A312E!important}
    .email-details{border-color:#3A312E!important}
    .email-details tr{background:#1E1A19!important}
    .email-divider{border-color:#3A312E!important}
    .email-footer{background:#141110!important}
    .email-footer-ink,.email-footer-ink a{color:#9B908B!important}
    .email-proj{background:#26211F!important;border-bottom-color:#3A312E!important}
    .email-proj tr{background:transparent!important}
    .email-card{border-top-color:#3A312E!important}
    .email-link{color:#F0A79B!important;border-color:#F0A79B!important}
    .email-chip-neutral{background:#332C2A!important;color:#E7E1DE!important}
    .email-chip-outline{background:transparent!important;color:#E7E1DE!important;border-color:#5A4E4A!important}
  }
  td,p,div,span,a,h1,h2{font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif}@media (max-width:480px){.em-tile{display:inline-block!important;width:50%!important;box-sizing:border-box!important}.em-col{display:block!important;width:auto!important;max-width:100%!important}.em-right{text-align:left!important;padding:6px 0 0!important;white-space:normal!important}.em-right .em-mini{float:none!important;margin:4px 0 0!important}.em-half{display:block!important;width:auto!important;padding:0 0 12px!important}.em-time{width:58px!important}.em-btn-wrap{width:100%!important}.email-btn{display:block!important;text-align:center!important}}@media (prefers-color-scheme:dark){.em-tile-box{background:#26211F!important;border-color:#3A312E!important}.em-track{background:#3A312E!important}.em-zero{background:#5A4E4A!important}.email-btn{color:#FFFFFF!important}.em-callout{background:#2F3844!important;color:#E7E1DE!important}.em-callout a{color:#82B4EA!important}.em-t-status-backlog{background:#3D3734!important;color:#B8AEA8!important}.em-t-status-todo{background:#39383B!important;color:#A7B5C8!important}.em-t-status-progress{background:#2F3844!important;color:#82B4EA!important}.em-t-status-blocked{background:#4A2D27!important;color:#EE8C79!important}.em-t-status-review{background:#3E3342!important;color:#BEA6E8!important}.em-t-status-done{background:#2C3C30!important;color:#63C490!important}.em-f-status-done{background:#4AB07A!important}.em-ink-status-done{color:#63C490!important}.em-t-prio-urgent{background:#4A2D27!important;color:#EE8C79!important}.em-f-prio-urgent{background:#E0644F!important}.em-ink-prio-urgent{color:#EE8C79!important}.em-t-prio-high{background:#4B3424!important;color:#F0A26A!important}.em-f-prio-high{background:#E8873F!important}.em-ink-prio-high{color:#F0A26A!important}.em-f-prio-normal{background:#8E9FB5!important}.em-ink-prio-normal{color:#A9B7CA!important}.em-t-prio-low{background:#3D3734!important;color:#B8AEA8!important}.em-f-prio-low{background:#A0958F!important}.em-ink-prio-low{color:#B8AEA8!important}.em-t-overdue{background:#4A2D27!important;color:#EE8C79!important}.em-ink-overdue{color:#EE8C79!important}.em-edge-overdue{border-left-color:#E0644F!important}.em-t-soon{background:#493824!important;color:#E6B266!important}.em-ink-soon{color:#E6B266!important}}
</style></head><body class="email-body" style="margin:0;padding:0;background:#F4F2F0;font-family:Arial,Helvetica,sans-serif"><div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent">1 overdue · 1 due today · 5 open · 1 meeting · 4 done this week&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-body" style="background:#F4F2F0"><tr><td align="center" style="padding:24px 12px"><!--[if mso]><table role="presentation" width="720" align="center" cellpadding="0" cellspacing="0"><tr><td><![endif]--><table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="email-container" style="width:100%;max-width:720px;background:#FFFFFF;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px -12px rgba(33,27,26,0.25)"><!-- Header: one slim line (logo or the email's own identity; an optional note such as the date) --><tr><td style="background:#8B1E1E;background:linear-gradient(135deg,#A83326 0%,#8B1E1E 55%,#5E1414 100%);padding:12px 32px" class="email-pad"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="left" style="vertical-align:middle"><span style="font-family:Arial,Helvetica,sans-serif;font-size:20px;font-weight:800;letter-spacing:-0.3px;color:#FFFFFF">MICO<span style="opacity:0.85">360</span> <span style="font-weight:600;opacity:0.9">Tasks</span></span></td><td class="email-head-note" align="right" style="vertical-align:middle;font-size:13px;color:#FFFFFF;opacity:0.9;white-space:nowrap">Wed 4 Nov 2026</td></tr></table></td></tr><!-- Body --><tr><td class="email-card email-pad" style="background:#FFFFFF;padding:28px 32px"><h1 class="email-heading" style="margin:0 0 16px;font-size:24px;line-height:1.25;font-weight:800;color:#211B1A">Good morning, Ada</h1><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td style="font-family:'Segoe UI',-apple-system,BlinkMacSystemFont,Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#211B1A"><h2 class="email-text" style="margin:22px 0 8px;font-size:16px;line-height:1.3;font-weight:800;color:#211B1A">Today at a glance</h2><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-tile" width="20%" valign="top" style="width:20%;padding:3px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-tile-box" bgcolor="#FAF7F6" style="padding:9px 10px;background:#FAF7F6;border:1px solid #E6DFDC;border-top:3px solid #62748A;border-radius:10px"><div class="em-tile-n email-text" style="font-size:22px;line-height:1.15;font-weight:800;color:#211B1A">5</div><div class="email-muted" style="margin-top:2px;font-size:12px;line-height:1.3;font-weight:400;color:#6C625F">Open</div></td></tr></table></td><td class="em-tile" width="20%" valign="top" style="width:20%;padding:3px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-tile-box" bgcolor="#FAF7F6" style="padding:9px 10px;background:#FAF7F6;border:1px solid #E6DFDC;border-top:3px solid #2F6DB5;border-radius:10px"><div class="em-tile-n email-text" style="font-size:22px;line-height:1.15;font-weight:800;color:#211B1A">2</div><div class="email-muted" style="margin-top:2px;font-size:12px;line-height:1.3;font-weight:400;color:#6C625F">In progress</div></td></tr></table></td><td class="em-tile" width="20%" valign="top" style="width:20%;padding:3px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-tile-box" bgcolor="#FAF7F6" style="padding:9px 10px;background:#FAF7F6;border:1px solid #E6DFDC;border-top:3px solid #5B6C82;border-radius:10px"><div class="em-tile-n email-text" style="font-size:22px;line-height:1.15;font-weight:800;color:#211B1A">3</div><div class="email-muted" style="margin-top:2px;font-size:12px;line-height:1.3;font-weight:400;color:#6C625F">Not started</div></td></tr></table></td><td class="em-tile" width="20%" valign="top" style="width:20%;padding:3px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-t-overdue" bgcolor="#FBEDEA" style="padding:9px 10px;background:#FBEDEA;border:1px solid #E6DFDC;border-top:3px solid #CB4632;border-radius:10px"><div class="em-tile-n em-ink-overdue" style="font-size:22px;line-height:1.15;font-weight:800;color:#B83E2B">1</div><div class="em-ink-overdue" style="margin-top:2px;font-size:12px;line-height:1.3;font-weight:700;color:#B83E2B">Overdue</div></td></tr></table></td><td class="em-tile" width="20%" valign="top" style="width:20%;padding:3px"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-tile-box" bgcolor="#FAF7F6" style="padding:9px 10px;background:#FAF7F6;border:1px solid #E6DFDC;border-top:3px solid #2E7D53;border-radius:10px"><div class="em-tile-n email-text" style="font-size:22px;line-height:1.15;font-weight:800;color:#211B1A">4</div><div class="email-muted" style="margin-top:2px;font-size:12px;line-height:1.3;font-weight:400;color:#6C625F">Done this week</div></td></tr></table></td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin:14px 0 0"><tr><td class="em-callout" bgcolor="#E9F0F7" style="background:#E9F0F7;border-left:4px solid #3A6EA5;border-radius:8px;padding:10px 14px;font-size:14px;line-height:1.5;color:#274b70">2 tasks are waiting for your approval. <a href="https://task.example/my-tasks#to-approve" target="_blank" style="font-weight:700;color:#274b70;text-decoration:underline">Review them</a></td></tr></table><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%"><tr><td class="em-half em-col" width="50%" valign="top" style="width:50%;padding-right:12px"><h2 class="email-text" style="margin:22px 0 8px;font-size:16px;line-height:1.3;font-weight:800;color:#211B1A">This week</h2><div class="email-muted" style="font-size:12px;line-height:1.4;color:#6C625F">Due this week</div><div class="email-text" style="margin:2px 0 6px;font-size:15px;line-height:1.35;font-weight:700;color:#211B1A">2 of 4 done · 50%</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;border-collapse:collapse"><tr><td class="em-f-status-done" width="50%" bgcolor="#2E7D53" style="width:50%;height:8px;background:#2E7D53;font-size:0;line-height:8px;mso-line-height-rule:exactly">&nbsp;</td><td class="em-track" width="50%" bgcolor="#ECE6E3" style="width:50%;height:8px;background:#ECE6E3;font-size:0;line-height:8px;mso-line-height-rule:exactly">&nbsp;</td></tr></table><div class="email-muted" style="margin-top:12px;font-size:12px;line-height:1.4;color:#6C625F">Done each day, last 7 days</div><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;margin-top:4px"><tr><td align="center" valign="bottom" width="14%" style="width:14%;padding:0 1px"><div class="email-muted" style="font-size:11px;line-height:14px;color:#6C625F">0</div><table role="presentation" width="16" cellpadding="0" cellspacing="0" style="width:16px;border-collapse:collapse"><tr><td width="16" class="em-zero" bgcolor="#D9D0CC" style="width:16px;height:2px;background:#D9D0CC;font-size:0;line-height:2px;mso-line-height-rule:exactly">&nbsp;</td></tr></table><div class="email-muted" style="font-size:11px;line-height:14px;color:#6C625F">Wed</div></td><td align="center" valign="bottom" width="14%" style="width:14%;padding:0 1px"><div class="email-muted" style="font-size:11px;line-height:14px;color:#6C625F">2</div><table role="presentation" width="16" cellpadding="0" cellspacing="0" style="width:16px;border-collapse:collapse"><tr><td width="16" class="em-f-status-done" bgcolor="#2E7D53" style="width:16px;height:36px;background:#2E7D53;font-size:0;line-hei